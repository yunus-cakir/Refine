<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Refine.App"
             xmlns:components="clr-namespace:Refine.App.Components" 
             x:Class="Refine.App.MainPage"
             BackgroundColor="#0f1115">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Grid VerticalOptions="End" HeightRequest="60" Margin="0" 
              InputTransparent="False"
              CascadeInputTransparent="False">

            <Border StrokeThickness="0" 
                    BackgroundColor="#FE0d0d0d" 
                    VerticalOptions="Fill" 
                    HorizontalOptions="Fill">
                <BoxView HeightRequest="1" Color="#33ffffff" VerticalOptions="Start" />
            </Border>

            <Grid ColumnDefinitions="*,*,*,*,*" Padding="0,5,0,0">

                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="workouts"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Path x:Name="PathWorkouts" Aspect="Uniform" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center"/>
                    <Label Text="Antrenman" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextWorkouts"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="programs"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Path x:Name="PathPrograms" Aspect="Uniform" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center"/>
                    <Label Text="Programlar" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextPrograms"/>
                </VerticalStackLayout>

                <Grid Grid.Column="2" WidthRequest="56" HeightRequest="56" VerticalOptions="Start" Margin="0,-30,0,0">
                    <Border StrokeShape="RoundRectangle 28"
                            StrokeThickness="4"
                            Stroke="#0f1115"
                            BackgroundColor="#ccff00"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">

                        <Border.Shadow>
                            <Shadow Brush="#ccff00" Offset="0,2" Opacity="0.15" Radius="5" />
                        </Border.Shadow>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter=""/>
                        </Border.GestureRecognizers>

                        <Path x:Name="PathHome"
                              Fill="#000000"
                              Aspect="Uniform" HeightRequest="24" WidthRequest="24" 
                              HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="exercises"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Path x:Name="PathExercises" Aspect="Uniform" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center"/>
                    <Label Text="Hareket" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextExercises"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="profile"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Path x:Name="PathProfile" Aspect="Uniform" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center"/>
                    <Label Text="Profil" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextProfile"/>
                </VerticalStackLayout>

            </Grid>
        </Grid>
    </Grid>
</ContentPage>