<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Refine.App"
             xmlns:components="clr-namespace:Refine.App.Components" 
             x:Class="Refine.App.MainPage"
             BackgroundColor="#0d0d0d">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- TOP APP BAR -->
        <Grid Grid.Row="0" HeightRequest="60" BackgroundColor="#0d0d0d" Padding="20,0">
            <Border StrokeThickness="0" BackgroundColor="#0d0d0d" VerticalOptions="Fill" HorizontalOptions="Fill">
                <BoxView HeightRequest="1" Color="#1Affffff" VerticalOptions="End" />
            </Border>

            <!-- HOME HEADER (Default) -->
            <Grid x:Name="HomeHeaderGrid">
                <!-- Center Logo Text -->
                <Label x:Name="HomeHeaderLogoText"
                       Text="REFINE STUDIO" 
                       TextColor="#ccff00" 
                       FontAttributes="Bold" 
                       FontSize="20" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       CharacterSpacing="1.5" />

                <!-- Profile Photo (Left) -->
                <Border x:Name="HomeHeaderProfileBorder"
                        HorizontalOptions="Start" VerticalOptions="Center"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="#c3f400"
                        HeightRequest="32" WidthRequest="32">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static local:IconPaths.Profile_Filled}"
                           FontFamily="MaterialFilled"
                           FontSize="20"
                           TextColor="#0d0d0d"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- LEGACY DETAIL HEADER (Hidden for reference) -->
            <Grid x:Name="LegacyDetailHeaderGrid" IsVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Arrow Back (Left) -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopBarLeftTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static local:IconPaths.ArrowBack}" FontFamily="MaterialOutlined" FontSize="24" TextColor="#ffffff" />
                </VerticalStackLayout>

                <!-- Title (Center) -->
                <Label x:Name="LegacyDetailHeaderTitle" 
                       Grid.Column="1" 
                       Text="WORKOUT NAME" 
                       TextColor="#FFFFFF" 
                       FontAttributes="Bold,Italic" 
                       FontSize="18" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center" 
                       CharacterSpacing="1.5" 
                       LineBreakMode="TailTruncation" 
                       MaxLines="1" />

                <!-- Settings Icon (Right) -->
                <VerticalStackLayout x:Name="LegacyDetailHeaderRightButton" Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopBarRightTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="{x:Static local:IconPaths.MoreVert}" FontFamily="MaterialOutlined" FontSize="24" TextColor="#ffffff" />
                </VerticalStackLayout>
            </Grid>

            <!-- NEW DETAIL HEADER (Nutrition Settings style) -->
            <Grid x:Name="DetailHeaderGrid" IsVisible="False" ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="0,5">
                
                <!-- Circular Back Button -->
                <Border Grid.Column="0" 
                        VerticalOptions="Center" 
                        WidthRequest="40" 
                        HeightRequest="40" 
                        Stroke="#0DFFFFFF" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#121312">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopBarLeftTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static local:IconPaths.ArrowBack}" 
                           FontFamily="MaterialOutlined" 
                           FontSize="20" 
                           TextColor="#ffffff" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>

                <!-- Title (Center-aligned) -->
                <Label x:Name="DetailHeaderTitle" 
                       Grid.Column="1" 
                       Text="WORKOUT NAME" 
                       TextColor="#FFFFFF" 
                       FontAttributes="Bold" 
                       FontSize="20" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" 
                       MaxLines="1" />

                <!-- Circular Settings Icon (Right) -->
                <Border x:Name="DetailHeaderRightButton" Grid.Column="2" 
                        VerticalOptions="Center" 
                        WidthRequest="40" 
                        HeightRequest="40" 
                        Stroke="#0DFFFFFF" 
                        StrokeThickness="1" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#121312">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTopBarRightTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static local:IconPaths.MoreVert}" 
                           FontFamily="MaterialOutlined" 
                           FontSize="20" 
                           TextColor="#ffffff" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- BLAZOR CONTENT -->
        <BlazorWebView Grid.Row="1" x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- BOTTOM APP BAR -->
        <Grid Grid.Row="2" HeightRequest="60" BackgroundColor="#0d0d0d">
            <Border StrokeThickness="0" BackgroundColor="#0d0d0d" VerticalOptions="Fill" HorizontalOptions="Fill">
                <BoxView HeightRequest="1" Color="#1Affffff" VerticalOptions="Start" />
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" Padding="0,5,0,0">
                <!-- 1. Home -->
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter=""/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IconHome" Text="{x:Static local:IconPaths.Home}" FontFamily="MaterialOutlined" FontSize="24" HorizontalOptions="Center" />
                    <Label Text="Home" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextHome"/>
                </VerticalStackLayout>

                <!-- 2. Workouts -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="workouts"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IconWorkouts" Text="{x:Static local:IconPaths.Workouts}" FontFamily="MaterialOutlined" FontSize="24" HorizontalOptions="Center" />
                    <Label Text="Workouts" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextWorkouts"/>
                </VerticalStackLayout>

                <!-- 3. Analytics -->
                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="analytics"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IconAnalytics" Text="{x:Static local:IconPaths.Analytics}" FontFamily="MaterialOutlined" FontSize="24" HorizontalOptions="Center" />
                    <Label Text="Analytics" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextAnalytics"/>
                </VerticalStackLayout>

                <!-- 4. Preferences (More) -->
                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavTapped" CommandParameter="preferences"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="IconMore" Text="{x:Static local:IconPaths.More}" FontFamily="MaterialOutlined" FontSize="24" HorizontalOptions="Center" />
                    <Label Text="More" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" x:Name="TextMore"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>