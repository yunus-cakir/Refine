<HomeCard
    WidthWeight="WidthWeight"
    IsLoading="IsLoading"
    Icon="favorite"
    Title="Recovery"
    PrimaryText="@Value.ToString()"
    PrimaryTextColor="var(--color-tertiary)"
    SecondaryText="%"
    ShowProgressBar="true"
    ProgressValue="@Value"
    ProgressColor="var(--color-primary-container)"
    ProgressBackgroundColor="var(--color-surface-container-highest)"
    OnClick="OnClick"
/>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int WidthWeight { get; set; } = 1;
    [Parameter] public int Value { get; set; } = 84;
    [Parameter] public EventCallback OnClick { get; set; }
}
