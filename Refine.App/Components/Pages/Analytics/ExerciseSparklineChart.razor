@using Refine.App.Models
@using Refine.App.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

<HomeCard 
    Icon="@(string.IsNullOrEmpty(ReverseLayout ? Subtitle : ExerciseName) ? "" : "fitness_center")"
    Title="@(ReverseLayout ? Subtitle : ExerciseName)"
    TitleColor="@(ReverseLayout ? "var(--color-on-surface-variant)" : "#ffffff")"
    OnClick="HandleClick"
    AdditionalAttributes="AdditionalAttributes">

    <HeaderRightContent>
        @if (ShowValueBadge)
        {
            <div class="d-flex flex-column align-items-end">
                @if (DataPoints != null && DataPoints.Any())
                {
                    <div class="metric-highlight" style="background-color: @(RateOfChange >= 0 ? "rgba(195, 244, 0, 0.1)" : "rgba(255, 69, 58, 0.1)"); border-color: @(RateOfChange >= 0 ? "rgba(195, 244, 0, 0.2)" : "rgba(255, 69, 58, 0.2)");">
                        <span class="fw-bold" style="color: @(RateOfChange >= 0 ? "#c3f400" : "#ff453a");">@DataPoints.Last().Value</span>
                        <small class="text-muted ms-1">@MetricUnitLabel</small>
                    </div>
                }
                <span class="badge mt-2" style="font-size: 11px; padding: 4px 8px; border-radius: 8px; font-weight: bold; background-color: @(RateOfChange >= 0 ? "rgba(195, 244, 0, 0.15)" : "rgba(255, 69, 58, 0.15)"); color: @(RateOfChange >= 0 ? "#c3f400" : "#ff453a");">
                    @(RateOfChange >= 0 ? "+" : "")@(Math.Round(RateOfChange * 100, 1))%
                </span>
            </div>
        }
        else
        {
            <div class="metric-highlight" style="background-color: @(RateOfChange >= 0 ? "rgba(195, 244, 0, 0.1)" : "rgba(255, 69, 58, 0.1)"); border-color: @(RateOfChange >= 0 ? "rgba(195, 244, 0, 0.2)" : "rgba(255, 69, 58, 0.2)");">
                <span class="fw-bold" style="color: @(RateOfChange >= 0 ? "#c3f400" : "#ff453a");">@(RateOfChange >= 0 ? "+" : "")@(Math.Round(RateOfChange * 100, 1))%</span>
            </div>
        }
    </HeaderRightContent>

    <Content>
        @if (ReverseLayout)
        {
            <h6 class="fw-bold mb-1" style="color: var(--refine-text);">@ExerciseName</h6>
        }
        else
        {
            <small class="text-muted mb-2">@(string.IsNullOrEmpty(Subtitle) ? $"Last Trained: {LastTrained.ToString("MMM dd")}" : Subtitle)</small>
        }
        <div class="sparkline-container" style="position: relative; z-index: 10; flex: 1; min-height: 50px;">
            <canvas @ref="_canvasRef"></canvas>
        </div>
    </Content>
</HomeCard>

@code {
    [Parameter] public int ExerciseId { get; set; }
    [Parameter] public string ExerciseName { get; set; } = string.Empty;
    [Parameter] public DateTime LastTrained { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public List<ChartDataPoint> DataPoints { get; set; } = new();
    [Parameter] public double RateOfChange { get; set; }
    [Parameter] public string MetricUnitLabel { get; set; } = "kg";
    [Parameter] public bool ShowValueBadge { get; set; } = true;
    [Parameter] public bool ReverseLayout { get; set; } = false;
    [Parameter] public EventCallback<int> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _canvasRef;
    private IJSObjectReference? _chartModule;
    private IJSObjectReference? _chartInstance;
    private bool _isRendered = false;

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(ExerciseId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _chartModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart-interop.js");
                await RenderChartAsync();
                _isRendered = true;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading chart module: {ex.Message}");
            }
        }
    }

    private int _lastExerciseId = -1;
    private int _lastDataPointCount = -1;
    private double _lastRateOfChange = double.NaN;

    protected override async Task OnParametersSetAsync()
    {
        if (_isRendered)
        {
            bool hasChanged = _lastExerciseId != ExerciseId || 
                              _lastDataPointCount != (DataPoints?.Count ?? 0) ||
                              _lastRateOfChange != RateOfChange;

            if (hasChanged)
            {
                _lastExerciseId = ExerciseId;
                _lastDataPointCount = DataPoints?.Count ?? 0;
                _lastRateOfChange = RateOfChange;
                await RenderChartAsync();
            }
        }
    }

    private async Task RenderChartAsync()
    {
        if (_chartModule != null && DataPoints != null && DataPoints.Count >= 2 && !string.IsNullOrEmpty(_canvasRef.Id))
        {
            await DestroyChartAsync();
            var labels = DataPoints.Select(d => d.Date.ToString("MMM dd")).ToArray();
            var data = DataPoints.Select(d => d.Value).ToArray();

            try
            {
                _chartInstance = await _chartModule.InvokeAsync<IJSObjectReference>("renderSparklineChart", _canvasRef, labels, data, RateOfChange >= 0);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error rendering sparkline: {ex.Message}");
            }
        }
    }

    private async Task DestroyChartAsync()
    {
        if (_chartInstance != null && _chartModule != null)
        {
            try
            {
                await _chartModule.InvokeVoidAsync("destroyChart", _chartInstance);
            }
            catch
            {
                // Ignore dispose errors
            }
            finally
            {
                if (_chartInstance != null)
                {
                    await _chartInstance.DisposeAsync();
                    _chartInstance = null;
                }
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await DestroyChartAsync();
        if (_chartModule != null)
        {
            await _chartModule.DisposeAsync();
        }
    }
}
