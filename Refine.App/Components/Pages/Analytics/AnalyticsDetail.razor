@page "/analytics/detail/{ExerciseId:int}"
@using Refine.App.Models
@using Refine.App.Services
@inject IJSRuntime JS
@inject LocalDbService DbService
@inject AnalyticsService AnalyticsSvc
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@implements IAsyncDisposable

<div class="analytics-container fade-in">
    <!-- Filters Section -->
    <div class="filters-section mb-4">
        <!-- Time Range Selector -->
        <div class="sorting-selector-container">
            <label class="sorting-label">Time Range</label>
            <div class="sorting-buttons">
                <button class="sorting-btn @(SelectedTimeframe == "14D" ? "active" : "")" @onclick='() => ChangeTimeframe("14D")'>
                    <span class="material-symbols-outlined btn-icon">calendar_today</span>
                    <span>14D</span>
                </button>
                <button class="sorting-btn @(SelectedTimeframe == "30D" ? "active" : "")" @onclick='() => ChangeTimeframe("30D")'>
                    <span class="material-symbols-outlined btn-icon">date_range</span>
                    <span>30D</span>
                </button>
                <button class="sorting-btn @(SelectedTimeframe == "90D" ? "active" : "")" @onclick='() => ChangeTimeframe("90D")'>
                    <span class="material-symbols-outlined btn-icon">calendar_month</span>
                    <span>90D</span>
                </button>
                <button class="sorting-btn @(SelectedTimeframe == "All" ? "active" : "")" @onclick='() => ChangeTimeframe("All")'>
                    <span class="material-symbols-outlined btn-icon">all_inclusive</span>
                    <span>All</span>
                </button>
            </div>
        </div>

        <!-- Metric Selector -->
        <div class="sorting-selector-container">
            <label class="sorting-label">Show Performance By</label>
            <div class="sorting-buttons">
                <button class="sorting-btn @(SelectedMetric == "ProgressiveOverload" ? "active" : "")" @onclick='() => ChangeMetric("ProgressiveOverload")'>
                    <span class="material-symbols-outlined btn-icon">monitoring</span>
                    <span>Progressive Overload</span>
                </button>
                <button class="sorting-btn @(SelectedMetric == "1RM" ? "active" : "")" @onclick='() => ChangeMetric("1RM")'>
                    <span class="material-symbols-outlined btn-icon">insights</span>
                    <span>Est. 1RM</span>
                </button>
                <button class="sorting-btn @(SelectedMetric == "MaxWeight" ? "active" : "")" @onclick='() => ChangeMetric("MaxWeight")'>
                    <span class="material-symbols-outlined btn-icon">fitness_center</span>
                    <span>Max Weight</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Chart Container -->
    <div class="chart-card">
        @if (isLoading)
        {
            <div class="skeleton-loader">
                <div class="skeleton-chart-area pulse"></div>
            </div>
        }
        else if (dataPoints == null || !dataPoints.Any())
        {
            <div class="empty-state">
                <span class="material-symbols-outlined empty-icon">query_stats</span>
                <p>No data available for the selected filters.</p>
            </div>
        }
        
        <div class="canvas-wrapper" style="@(isLoading || (dataPoints == null || !dataPoints.Any()) ? "display:none;" : "display:block;")">
            <canvas @ref="chartCanvas"></canvas>
        </div>
    </div>

    <!-- History Section -->
    <div class="history-section mt-4">
        <h5 class="font-headline fw-bold mb-3">History</h5>
        @if (cachedLogs != null && cachedLogs.Any())
        {
            @foreach (var dateGroup in cachedLogs.GroupBy(l => l.Date.Date).OrderByDescending(g => g.Key))
            {
                <div class="mb-4">
                    <div class="small fw-bold text-muted mb-2 ms-1">@dateGroup.Key.ToString("dd MMMM yyyy, dddd")</div>
                    <div class="refine-card p-3">
                        <div class="row g-2 mb-2 text-muted small fw-bold text-center border-bottom border-secondary pb-1">
                            <div class="col-2">SET</div>
                            <div class="col-3">WEIGHT</div>
                            <div class="col-3">REPS</div>
                            <div class="col-2">RIR</div>
                            <div class="col-2">FORM</div>
                        </div>

                        @foreach (var log in dateGroup.OrderBy(l => l.SetNumber))
                        {
                            <div class="row g-2 mb-2 align-items-center text-center">
                                <div class="col-2">
                                    <span class="badge bg-secondary rounded-circle" style="width:24px; height:24px;">@log.SetNumber</span>
                                </div>

                                <div class="col-3 fw-bold text-white">@(log.Weight.HasValue ? log.Weight : "-")</div>
                                <div class="col-3 fw-bold text-white">@(log.Reps.HasValue ? log.Reps : "-")</div>

                                <div class="col-2 text-warning">@(log.RIR.HasValue ? log.RIR : "-")</div>

                                <div class="col-2 text-center">
                                    @if (log.FormRating == 3)
                                    {
                                        <i class="bi bi-fire" style="color: #ff0055;"></i>
                                    }
                                    else if (log.FormRating == 2)
                                    {
                                        <i class="bi bi-emoji-smile-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-emoji-neutral-fill text-warning"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else if (!isLoading)
        {
            <div class="text-muted small">No history available for this exercise.</div>
        }
    </div>
</div>

@code {
    private List<WorkoutLog> cachedLogs = new();
    private List<ChartDataPoint> dataPoints = new();
    
    private bool isLoading = true;
    private bool isFirstRenderComplete = false;
    
    [Parameter]
    public int ExerciseId { get; set; }

    [SupplyParameterFromQuery(Name = "name")]
    public string? ExerciseName { get; set; }
    
    private int _selectedExerciseId;

    private string _selectedTimeframe = "30D";
    public string SelectedTimeframe
    {
        get => _selectedTimeframe;
        set
        {
            if (_selectedTimeframe != value)
            {
                _selectedTimeframe = value;
                _ = CrunchDataAsync();
            }
        }
    }

    private string _selectedMetric = "ProgressiveOverload";
    public string SelectedMetric
    {
        get => _selectedMetric;
        set
        {
            if (_selectedMetric != value)
            {
                _selectedMetric = value;
                _ = CrunchDataAsync();
            }
        }
    }

    private IJSObjectReference? chartModule;
    private IJSObjectReference? chartInstance;
    private ElementReference chartCanvas;

    protected override void OnInitialized()
    {
        TopBar.OnLeftActionTapped += HandleLeftAction;
        if (!string.IsNullOrEmpty(ExerciseName))
        {
            TopBar.SetDetailMode(ExerciseName);
        }
    }

    private async void HandleLeftAction()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(ExerciseName))
        {
            TopBar.SetDetailMode("Analytics");
        }

        var exercise = await DbService.GetExerciseByIdAsync(ExerciseId);

        if (exercise != null)
        {
            _selectedExerciseId = exercise.Id;
            if (string.IsNullOrEmpty(ExerciseName))
            {
                TopBar.SetDetailMode(exercise.Name);
            }
            
            // Initialization is handled here without blocking the UI
            await HandleExerciseChanged();
        }
        else
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isFirstRenderComplete = true;
            chartModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chart-interop.js");
            if (!isLoading && dataPoints.Any())
            {
                await RenderOrUpdateChartAsync();
            }
        }
    }

    private async Task HandleExerciseChanged()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        
        // Background thread for querying the database and crunching
        await Task.Run(async () =>
        {
            cachedLogs = await DbService.GetLogsForExerciseAsync(_selectedExerciseId);
            await CrunchDataInternalAsync();
        });

        isLoading = false;
        await InvokeAsync(StateHasChanged);
        
        if (isFirstRenderComplete)
        {
            await RenderOrUpdateChartAsync();
        }
    }

    private async Task ChangeTimeframe(string timeframe)
    {
        if (SelectedTimeframe == timeframe) return;
        SelectedTimeframe = timeframe;
        await Task.CompletedTask;
    }

    private async Task ChangeMetric(string metric)
    {
        if (SelectedMetric == metric) return;
        SelectedMetric = metric;
        await Task.CompletedTask;
    }

    private async Task CrunchDataAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        // Background thread for number crunching (No DB query)
        await Task.Run(async () =>
        {
             await CrunchDataInternalAsync();
        });

        isLoading = false;
        await InvokeAsync(StateHasChanged);
        
        if (isFirstRenderComplete)
        {
            await RenderOrUpdateChartAsync();
        }
    }

    private Task CrunchDataInternalAsync()
    {
        dataPoints = AnalyticsSvc.ProcessLogs(cachedLogs, SelectedTimeframe, SelectedMetric);
        return Task.CompletedTask;
    }

    private async Task RenderOrUpdateChartAsync()
    {
        if (chartModule == null || dataPoints == null || !dataPoints.Any())
            return;

        var labels = dataPoints.Select(d => d.Date.ToString("MMM dd")).ToArray();
        var data = dataPoints.Select(d => d.Value).ToArray();
        var datasetLabel = SelectedMetric switch
        {
            "MaxWeight" => "Max Weight",
            "1RM" => "Est. 1RM",
            "ProgressiveOverload" => "Progressive Overload",
            _ => "Est. 1RM"
        };

        var first = dataPoints.FirstOrDefault()?.Value ?? 0;
        var last = dataPoints.LastOrDefault()?.Value ?? 0;
        var isPositive = last >= first;

        if (chartInstance == null)
        {
            chartInstance = await chartModule.InvokeAsync<IJSObjectReference>("renderLineChart", chartCanvas, labels, data, datasetLabel, isPositive);
        }
        else
        {
            await chartModule.InvokeVoidAsync("updateChart", chartInstance, labels, data, datasetLabel, isPositive);
        }
    }

    public async ValueTask DisposeAsync()
    {
        TopBar.OnLeftActionTapped -= HandleLeftAction;

        if (chartModule != null && chartInstance != null)
        {
            await chartModule.InvokeVoidAsync("destroyChart", chartInstance);
        }
        
        if (chartModule != null)
        {
            await chartModule.DisposeAsync();
        }

        var nextUri = NavManager.Uri;
        if (!nextUri.Contains("/workouts/detail/") && 
            !nextUri.Contains("/session/active/") && 
            !nextUri.Contains("/session/edit/") &&
            !nextUri.Contains("/analytics/detail/"))
        {
            if (TopBar.CurrentConfig.Mode == TopBarMode.Detail)
            {
                TopBar.SetHomeMode(string.Empty);
            }
        }
    }
}
