@page "/programs/edit/{Id:int}"
@using Refine.App.Models.Entities
@using Refine.App.Models.UI
@using Refine.App.Models.Enums
@using Refine.App.Services

@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject TopBarBridge TopBar
@inject IPopupService PopupService

<div class="page-container py-4 px-0 min-h-screen">
    @if (_isLoading)
    {
        <RfSpinner IsLoading="true"/>
    }
    else
    {
        <div class="animate-fade-in">
            <EditForm Model="@_program" OnValidSubmit="SaveProgram">
                <DataAnnotationsValidator/>

                <RfInput Title="Program Name" Icon="fitness_center" Placeholder="e.g. 5x5 Power" WrapperClass="mb-2" @bind-Value="_program.Name"/>

                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <RfDropdown TValue="string"
                                    WrapperClass="mb-0"
                                    Title="Level"
                                    Placeholder="Select Level"
                                    SheetTitle="SELECT LEVEL"
                                    @bind-Value="_program.Level"
                                    Options="_levelOptions"/>
                    </div>
                    <div class="col-6">
                        <RfDropdown TValue="string"
                                    WrapperClass="mb-0"
                                    Title="Goal"
                                    Placeholder="Select Goal"
                                    SheetTitle="SELECT GOAL"
                                    @bind-Value="_program.Goal"
                                    Options="_goalOptions"/>
                    </div>
                </div>

                <RfDropdown TValue="string"
                            WrapperClass="mb-2"
                            Title="Environment"
                            Icon="location_on"
                            Placeholder="Select Environment"
                            SheetTitle="SELECT ENVIRONMENT"
                            @bind-Value="_program.Environment"
                            Options="_environmentOptions"/>

                @if (Id != 0)
                {
                    <div class="mt-2">
                        <div class="rf-flex-row rf-items-center rf-justify-between mb-3 px-1">
                            <div class="rf-flex-row rf-items-center" style="gap: 8px;">
                                <h3 class="font-headline" style="font-size: 20px; color: var(--color-primary); font-weight: 600; margin: 0;">Workout Days</h3>
                                <span class="@(_isSelected ? "rf-badge" : "rf-badge-faded")" style="font-size: 10px; padding: 3px 10px;">
                                    @(_program.Workouts?.Count ?? 0) DAYS
                                </span>
                            </div>

                            <a href="@($"/workouts/edit/{Id}/0")" class="refine-icon-btn" style="width: auto; height: 32px; padding: 0 12px; border-radius: 16px; display: flex; align-items: center; gap: 4px; background-color: rgba(195, 244, 0, 0.1); color: var(--color-primary-fixed); border-color: rgba(195, 244, 0, 0.2); text-decoration: none;">
                                <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                                <span class="font-label" style="font-size: 11px; font-weight: bold; letter-spacing: 0.05em;">ADD</span>
                            </a>
                        </div>

                        <div id="workout-list" class="d-flex flex-column gap-3 mb-2">
                            @if (_program.Workouts != null && _program.Workouts.Any())
                            {
                                @foreach (var workout in _program.Workouts.OrderBy(w => w.Order))
                                {
                                    <div class="rf-card d-flex justify-content-between align-items-center exercise-card" style="padding: 12px 16px;" @key="workout.Id">
                                        <div class="d-flex align-items-center">
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-white fs-5">@workout.Name</span>
                                                <span class="text-on-surface-variant lh-1" style="font-size: 14px; margin-top: 1px;">@(workout.Items?.Count ?? 0) Exercises &bull; @(workout.Items?.Sum(i => i.Sets) ?? 0) Sets</span>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm text-white icon-btn" @onclick="() => MoveItemUp(workout)" disabled="@(workout.Order == 1)">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_upward</span>
                                            </button>
                                            <button type="button" class="btn btn-sm text-white icon-btn" @onclick="() => MoveItemDown(workout)" disabled="@(_program.Workouts == null || workout.Order == _program.Workouts.Count)">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_downward</span>
                                            </button>
                                            <a href="@($"/workouts/edit/{Id}/{workout.Id}")" class="btn btn-sm text-white icon-btn">
                                                <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                            </a>
                                            <button type="button" class="btn btn-sm border-0 icon-btn" @onclick="() => DeleteWorkout(workout)">
                                                <span class="material-symbols-outlined" style="font-size: 18px; color: #ff4d4d;">close</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-4 rounded mb-2" style="border: 1px dashed rgba(255,255,255,0.2); color: rgba(255,255,255,0.4);">
                                    No workouts added yet.
                                </div>
                            }
                        </div>
                    </div>
                }

                <RfButton IsSticky="true" Icon="@(Id == 0 ? "add" : "check")" Text="@(Id == 0 ? "CREATE PROGRAM" : "SAVE PROGRAM")"/>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private WorkoutProgram _program = new();
    private bool _isLoading = true;
    private bool _isSelected;

    private List<RfDropdownOption<string>> _levelOptions = new()
    {
        new() { Value = "Beginner", Text = "Beginner" },
        new() { Value = "Intermediate", Text = "Intermediate" },
        new() { Value = "Advanced", Text = "Advanced" }
    };

    private List<RfDropdownOption<string>> _goalOptions = new()
    {
        new() { Value = "Hypertrophy", Text = "Hypertrophy" },
        new() { Value = "Strength", Text = "Strength" },
        new() { Value = "Fat Loss", Text = "Fat Loss" },
        new() { Value = "Endurance", Text = "Endurance" }
    };

    private List<RfDropdownOption<string>> _environmentOptions = new()
    {
        new() { Value = "Gym", Text = "Gym", Icon = "fitness_center" },
        new() { Value = "Home", Text = "Home", Icon = "home" },
        new() { Value = "Outdoor", Text = "Outdoor", Icon = "park" },
        new() { Value = "Track", Text = "Track", Icon = "sprint" }
    };


    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            TopBar.SetDetailMode(Id == 0 ? "New Program" : "Edit Program");

            if (Id != 0)
            {
                await LoadProgramData();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadProgramData()
    {
        var existing = await DbService.GetProgramByIdAsync(Id);
        if (existing != null)
            _program = existing;

        var selectedProgram = await DbService.GetSelectedWorkoutProgramAsync();
        _isSelected = selectedProgram != null && selectedProgram.Id == Id;
    }


    private async Task SaveProgram()
    {
        int newId = await DbService.SaveWorkoutProgramAsync(_program);

        if (Id == 0)
        {
            Id = newId;
            NavManager.NavigateTo($"/programs/edit/{newId}", replace: true);
            TopBar.SetDetailMode("Edit Program");
            await LoadProgramData();
        }
        else
        {
            await UiHelper.ShowAlert("Success", "Program updated successfully.", "OK");
        }
    }


    private async Task DeleteWorkout(Workout w)
    {
        var result = await PopupService.ShowAsync(new PopupOptions
        {
            Title = "Delete Workout",
            Description = $"Delete '{w.Name}'?",
            Icon = "close",
            Mode = PopupMode.Confirmation,
            CustomButtons = new List<PopupButton>
            {
                new() { Text = "Delete", ActionId = PopupResult.ConfirmedAction, Type = PopupButtonType.Destructive },
                new() { Text = "Cancel", ActionId = PopupResult.RejectedAction, Type = PopupButtonType.Ghost }
            }
        });

        if (result.IsConfirmed)
        {
            await DbService.DeleteWorkoutAsync(w.Id);
            await LoadProgramData();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Sortable logic removed
        await Task.CompletedTask;
    }

    private async Task MoveItemUp(Workout workout)
    {
        if (workout.Order <= 1) return;
        var sortedList = _program.Workouts.OrderBy(w => w.Order).ToList();
        var index = sortedList.FindIndex(w => w.Id == workout.Id);
        if (index > 0)
        {
            var prev = sortedList[index - 1];
            (workout.Order, prev.Order) = (prev.Order, workout.Order);
            _program.Workouts = sortedList.OrderBy(w => w.Order).ToList();
            await DbService.UpdateWorkoutOrdersAsync(_program.Workouts);
        }
    }

    private async Task MoveItemDown(Workout workout)
    {
        if (_program.Workouts == null) return;
        if (workout.Order >= _program.Workouts.Count) return;
        var sortedList = _program.Workouts.OrderBy(w => w.Order).ToList();
        var index = sortedList.FindIndex(w => w.Id == workout.Id);
        if (index < sortedList.Count - 1)
        {
            var next = sortedList[index + 1];
            (workout.Order, next.Order) = (next.Order, workout.Order);
            _program.Workouts = sortedList.OrderBy(w => w.Order).ToList();
            await DbService.UpdateWorkoutOrdersAsync(_program.Workouts);
        }
    }

}

