@page "/profile/nutrition-settings"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar

<div class="page-container py-4 px-0 min-h-screen">

    @if (_user == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary-container" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Placeholder Card -->
        <div class="rf-card animate-fade-in p-4 mb-4 text-center">
            <div class="icon-glow mb-3 mx-auto d-flex align-items-center justify-content-center">
                <span class="material-symbols-outlined text-primary-container" style="font-size: 32px;">restaurant</span>
            </div>
            <h5 class="text-white fw-bold mb-2">Configure Your Nutrition</h5>
            <p class="text-on-surface-variant small mb-0 px-3">
                Nutrition parameters, daily target calorie intake, macronutrient distribution, and metabolism types will be fully editable here soon.
            </p>
        </div>
    }
</div>

@code {
    private User? _user;

    protected override void OnInitialized()
    {
        TopBar.SetDetailMode("Nutrition Settings");
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await DbService.GetUserAsync();
    }

}
