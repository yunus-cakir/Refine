@page "/profile"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar

<div class="page-container py-4 px-0 min-h-screen">
    @if (_user == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary-container" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Profile Header -->
        <div class="profile-header d-flex align-items-center justify-content-between mb-5 animate-fade-in px-3">
            <div class="d-flex align-items-center gap-3">
                <!-- Glowing Avatar -->
                <div class="avatar-container">
                    <div class="avatar-icon-bg">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                </div>
                <!-- User Info -->
                <div class="user-info">
                    <h2 class="user-name font-headline m-0">
                        @(string.IsNullOrWhiteSpace(_user.FirstName) && string.IsNullOrWhiteSpace(_user.LastName) ? "John Doe" : $"{_user.FirstName} {_user.LastName}")
                    </h2>
                    <div class="badge-container d-flex align-items-center gap-1 mt-1">
                        <span class="material-symbols-outlined badge-icon">stars</span>
                        <span class="badge-text">ELITE MEMBER</span>
                    </div>
                </div>
            </div>

            <!-- Edit Profile Button -->
            <button class="edit-btn d-flex align-items-center justify-content-center" @onclick='() => NavManager.NavigateTo("/profile/edit")'>
                <span class="material-symbols-outlined text-white" style="font-size: 20px;">edit</span>
            </button>
        </div>

        <More IsEmbedded="true"/>
    }
</div>

@code {
    private User? _user;

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetStandardMode("Profile");
        _user = await DbService.GetUserAsync();
    }


}
