@page "/profile"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@implements IDisposable

<div class="page-container py-4 px-0 min-h-screen">
    @if (_user == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary-container" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Profile Header -->
        <div class="profile-header d-flex align-items-center justify-content-between mb-5 animate-fade-in">
            <div class="d-flex align-items-center gap-3">
                <!-- Glowing Avatar -->
                <div class="avatar-container">
                    <div class="avatar-icon-bg">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                </div>
                <!-- User Info -->
                <div class="user-info">
                    <h2 class="user-name font-headline m-0">
                        @(string.IsNullOrWhiteSpace(_user.FirstName) && string.IsNullOrWhiteSpace(_user.LastName) ? "Alex Mercer" : $"{_user.FirstName} {_user.LastName}")
                    </h2>
                    <div class="badge-container d-flex align-items-center gap-1 mt-1">
                        <span class="material-symbols-outlined badge-icon">stars</span>
                        <span class="badge-text">ELITE MEMBER</span>
                    </div>
                </div>
            </div>
            
            <!-- Edit Profile Button -->
            <button class="edit-btn d-flex align-items-center justify-content-center" @onclick='() => NavManager.NavigateTo("/profile/edit")'>
                <span class="material-symbols-outlined text-white" style="font-size: 20px;">edit</span>
            </button>
        </div>

        <!-- Menu List -->
        <div class="menu-list d-flex flex-column gap-3 animate-fade-in">
            <!-- Body Measurements -->
            <div class="menu-card d-flex align-items-center justify-content-between" @onclick='() => NavManager.NavigateTo("/profile/body-measurements")'>
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined menu-icon">straighten</span>
                    </div>
                    <span class="menu-title">Body Measurements</span>
                </div>
                <span class="material-symbols-outlined chevron-icon">chevron_right</span>
            </div>

            <!-- Workout Settings -->
            <div class="menu-card d-flex align-items-center justify-content-between" @onclick='() => NavManager.NavigateTo("/profile/workout-settings")'>
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined menu-icon">fitness_center</span>
                    </div>
                    <span class="menu-title">Workout Settings</span>
                </div>
                <span class="material-symbols-outlined chevron-icon">chevron_right</span>
            </div>

            <!-- Nutrition Settings -->
            <div class="menu-card d-flex align-items-center justify-content-between" @onclick='() => NavManager.NavigateTo("/profile/nutrition-settings")'>
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined menu-icon">restaurant</span>
                    </div>
                    <span class="menu-title">Nutrition Settings</span>
                </div>
                <span class="material-symbols-outlined chevron-icon">chevron_right</span>
            </div>

            <!-- App Settings -->
            <div class="menu-card d-flex align-items-center justify-content-between" @onclick='() => NavManager.NavigateTo("/profile/app-settings")'>
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-box d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined menu-icon">settings</span>
                    </div>
                    <span class="menu-title">App Settings</span>
                </div>
                <span class="material-symbols-outlined chevron-icon">chevron_right</span>
            </div>
        </div>
    }
</div>

@code {
    private User? _user;

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetStandardMode("Profile");
        _user = await DbService.GetUserAsync();
    }

    public void Dispose()
    {
        var nextUri = NavManager.Uri;
        if (nextUri.Contains("/workouts/detail/") || 
            nextUri.Contains("/session/active/") || 
            nextUri.Contains("/session/edit/"))
        {
            return;
        }

        if (TopBar.CurrentConfig.Title == "Profile")
        {
            TopBar.SetHomeMode(string.Empty);
        }
    }
}
