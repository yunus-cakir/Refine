@page "/profile/edit"
@using Refine.App.Models.Entities
@using Refine.App.Models.UI
@using Refine.App.Models.Enums
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar

@if (_user == null)
{
    <RfSpinner IsLoading="true" />
}
else
{
<div class="page-container py-4 px-0 min-h-screen animate-fade-in">
        <!-- Avatar Section -->
        <div class="text-center mb-5 mt-2">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px; border: 4px solid var(--refine-primary-container); background-color: #C3F400;">
                <span class="material-symbols-outlined" style="font-size: 64px; font-variation-settings: 'FILL' 1; color: #000000;">person</span>
            </div>
        </div>

        <!-- Form Section -->
        <RfInput Title="First Name" Icon="person" Placeholder="Enter first name" @bind-Value="_user.FirstName" />

        <RfInput Title="Last Name" Icon="badge" Placeholder="Enter last name" Delay="0.05" @bind-Value="_user.LastName" />

        <RfInput Title="Email Address" Icon="mail" Type="email" Placeholder="Enter email address" Delay="0.1" @bind-Value="_user.Email" />

        <RfDropdown TValue="Gender"
                    Title="Gender"
                    Icon="wc"
                    Placeholder="Select Gender"
                    SheetTitle="SELECT CLASSIFICATION"
                    Delay="0.15"
                    @bind-Value="_user.Gender"
                    Options="_genderOptions" />

        <!-- Save Button -->
        <div class="mt-4 px-1">
            <RfButton Icon="check" Text="SAVE PROFILE" OnClick="SaveProfile" />
        </div>
</div>
}

@code {
    private User? _user;
    
    private List<RfDropdownOption<Gender>> _genderOptions = new()
    {
        new() { Value = Gender.Male, Text = "Male", Icon = "male" },
        new() { Value = Gender.Female, Text = "Female", Icon = "female" }
    };

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetDetailMode("Edit Profile");
        _user = await DbService.GetUserAsync();
    }

    private async Task SaveProfile()
    {
        if (_user != null)
        {
            await DbService.UpdateUserAsync(_user);
            NavManager.NavigateTo("/profile");
        }
    }
}

