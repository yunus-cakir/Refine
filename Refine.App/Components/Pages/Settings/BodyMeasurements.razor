@page "/profile/body-measurements"
@using Refine.App.Models
@using Refine.App.Services
@implements IDisposable
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar

@if (_user == null)
{
    <RfSpinner IsLoading="true"/>
}
else
{
    <div class="page-container py-4 min-h-screen">
        <div class="animate-fade-in">
            <!-- Top measurement cards: AGE, BOY & KILO -->
            <div class="row g-3 mb-4">
                <!-- AGE Card -->
                <div class="col-4">
                    <div class="refine-active-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="refine-input-label" style="margin-bottom: 0;">AGE</span>
                            <span class="material-symbols-outlined label-icon-top" style="line-height: 1;">calendar_today</span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <input type="number" class="rf-input-number" style="width: 100%;" placeholder="@(_ghostAge?.ToString() ?? "---")" @bind="_inputAge"/>
                            <span class="mt-2" style="font-size: 11px; font-weight: 700; color: #8c887d; letter-spacing: 0.05em; text-transform: uppercase;">YEARS</span>
                        </div>
                    </div>
                </div>

                <!-- BOY Card -->
                <div class="col-4">
                    <div class="refine-active-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="refine-input-label" style="margin-bottom: 0;">HEIGHT</span>
                            <span class="material-symbols-outlined label-icon-top" style="line-height: 1;">height</span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <input type="number" step="any" class="rf-input-number" style="width: 100%;" placeholder="@(_ghostHeight?.ToString() ?? "---")" @bind="_inputHeight"/>
                            <span class="mt-2" style="font-size: 11px; font-weight: 700; color: #8c887d; letter-spacing: 0.05em; text-transform: uppercase;">cm</span>
                        </div>
                    </div>
                </div>

                <!-- KILO Card -->
                <div class="col-4">
                    <div class="refine-active-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="refine-input-label" style="margin-bottom: 0;">WEIGHT</span>
                            <span class="material-symbols-outlined label-icon-top" style="line-height: 1;">weight</span>
                        </div>
                        <div class="d-flex flex-column align-items-center">
                            <input type="number" step="any" class="rf-input-number" style="width: 100%;" placeholder="@(_ghostWeight?.ToString() ?? "---")" @bind="_inputWeight"/>
                            <span class="mt-2" style="font-size: 11px; font-weight: 700; color: #8c887d; letter-spacing: 0.05em; text-transform: uppercase;">kg</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Circumference Section Header -->
            <div class="mb-3">
                <h5 class="refine-input-label" style="font-size: 13px; letter-spacing: 0.1em; color: var(--color-on-surface-variant);">CIRCUMFERENCE DATA</h5>
                <hr style="border-color: rgba(255, 255, 255, 0.08); margin: 0;"/>
            </div>

            <!-- Circumference rows -->
            <div class="d-flex flex-column gap-3 mb-4">
                <!-- Boyun çevresi -->
                <div class="refine-active-card p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="row-icon-container">
                            <span class="material-symbols-outlined row-icon">line_weight</span>
                        </div>
                        <span class="refine-input-label" style="margin: 0; font-size: 15px;">Neck</span>
                    </div>
                    <div class="input-wrapper" style="width: 130px;">
                        <input type="number" step="any" class="rf-input-number" style="padding-right: 42px; width: 100%;" placeholder="@(_ghostNeck?.ToString() ?? "---")" @bind="_inputNeck"/>
                        <span class="unit-label">cm</span>
                    </div>
                </div>

                <!-- Omuz çevresi -->
                <div class="refine-active-card p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="row-icon-container">
                            <span class="material-symbols-outlined row-icon">sports_gymnastics</span>
                        </div>
                        <span class="refine-input-label" style="margin: 0; font-size: 15px;">Shoulders</span>
                    </div>
                    <div class="input-wrapper" style="width: 130px;">
                        <input type="number" step="any" class="rf-input-number" style="padding-right: 42px; width: 100%;" placeholder="@(_ghostShoulder?.ToString() ?? "---")" @bind="_inputShoulder"/>
                        <span class="unit-label">cm</span>
                    </div>
                </div>

                <!-- Bel çevresi -->
                <div class="refine-active-card p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="row-icon-container">
                            <span class="material-symbols-outlined row-icon">accessibility</span>
                        </div>
                        <span class="refine-input-label" style="margin: 0; font-size: 15px;">Waist</span>
                    </div>
                    <div class="input-wrapper" style="width: 130px;">
                        <input type="number" step="any" class="rf-input-number" style="padding-right: 42px; width: 100%;" placeholder="@(_ghostWaist?.ToString() ?? "---")" @bind="_inputWaist"/>
                        <span class="unit-label">cm</span>
                    </div>
                </div>

                <!-- Kalça çevresi -->
                <div class="refine-active-card p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <div class="row-icon-container">
                            <span class="material-symbols-outlined row-icon">boy</span>
                        </div>
                        <span class="refine-input-label" style="margin: 0; font-size: 15px;">Hips</span>
                    </div>
                    <div class="input-wrapper" style="width: 130px;">
                        <input type="number" step="any" class="rf-input-number" style="padding-right: 42px; width: 100%;" placeholder="@(_ghostHip?.ToString() ?? "---")" @bind="_inputHip"/>
                        <span class="unit-label">cm</span>
                    </div>
                </div>
            </div>

            <!-- Save Button -->
            <RfButton IsSticky="true" Icon="check" Text="SAVE" OnClick="SaveMeasurements"/>
        </div>
    </div>
}

@code {
    private User? _user;

    // Optional input fields (null unless entered)
    private int? _inputAge;
    private double? _inputHeight;
    private double? _inputWeight;
    private double? _inputNeck;
    private double? _inputShoulder;
    private double? _inputWaist;
    private double? _inputHip;

    // Previous values for ghost text placeholders
    private int? _ghostAge;
    private double? _ghostHeight;
    private double? _ghostWeight;
    private double? _ghostNeck;
    private double? _ghostShoulder;
    private double? _ghostWaist;
    private double? _ghostHip;

    protected override void OnInitialized()
    {
        TopBar.SetDetailMode("BODY MEASUREMENTS");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUserAndGhostValues();
    }


    private async Task LoadUserAndGhostValues()
    {
        _user = await DbService.GetUserAsync();
        if (_user != null)
        {
            _ghostAge = _user.Age > 0 ? _user.Age : null;

            // Height is a flat cached biometric property
            _ghostHeight = _user.Height > 0 ? _user.Height : null;

            // Weight is also flat cached on User but we can check if they have logs
            _ghostWeight = _user.Weight > 0 ? _user.Weight : null;

            // Load latest non-null values for optional circumferences from BiometricLogs
            if (_user.BiometricLogs != null && _user.BiometricLogs.Any())
            {
                var sortedLogs = _user.BiometricLogs.OrderByDescending(l => l.Date).ToList();
                _ghostNeck = sortedLogs.FirstOrDefault(l => l.Neck.HasValue)?.Neck;
                _ghostShoulder = sortedLogs.FirstOrDefault(l => l.Shoulder.HasValue)?.Shoulder;
                _ghostWaist = sortedLogs.FirstOrDefault(l => l.Waist.HasValue)?.Waist;
                _ghostHip = sortedLogs.FirstOrDefault(l => l.Hip.HasValue)?.Hip;
            }
        }
    }

    private async Task SaveMeasurements()
    {
        if (_user == null) return;

        // Verify if at least one value was modified/entered
        bool hasEnteredData = _inputAge.HasValue || _inputHeight.HasValue || _inputWeight.HasValue || _inputNeck.HasValue ||
                              _inputShoulder.HasValue || _inputWaist.HasValue || _inputHip.HasValue;

        if (!hasEnteredData)
        {
            await UiHelper.ShowAlert("Bilgi", "Kaydetmek için lütfen en az bir yeni ölçüm değeri giriniz.", "Tamam");
            return;
        }

        try
        {
            // 1. Update flat user attributes (Age, Height)
            bool userUpdated = false;
            if (_inputAge.HasValue)
            {
                _user.Age = _inputAge.Value;
                userUpdated = true;
            }

            if (_inputHeight.HasValue)
            {
                _user.Height = _inputHeight.Value;
                userUpdated = true;
            }

            if (userUpdated)
            {
                await DbService.UpdateUserAsync(_user);
            }

            // 2. If any biometric logs fields were entered, save a new log with only those values
            bool hasLogData = _inputWeight.HasValue || _inputNeck.HasValue || _inputShoulder.HasValue ||
                              _inputWaist.HasValue || _inputHip.HasValue;

            if (hasLogData)
            {
                var log = new BiometricLog
                {
                    UserId = _user.Id,
                    Date = DateTime.Now,
                    Weight = _inputWeight, // Null if not entered, AddBiometricLogAsync handles conditionally updating user weight
                    Neck = _inputNeck,
                    Shoulder = _inputShoulder,
                    Waist = _inputWaist,
                    Hip = _inputHip
                };

                await DbService.AddBiometricLogAsync(log);
            }

            // Show safe confirmation alert
            await UiHelper.ShowAlert("Başarılı", "Girdiğiniz ölçüm verileri başarıyla kaydedildi.", "Tamam");

            // Clear inputs so placeholders show the new values
            _inputAge = null;
            _inputHeight = null;
            _inputWeight = null;
            _inputNeck = null;
            _inputShoulder = null;
            _inputWaist = null;
            _inputHip = null;

            // Reload user data and ghost placeholders
            await LoadUserAndGhostValues();
        }
        catch (Exception ex)
        {
            await UiHelper.ShowAlert("Hata", $"Ölçümler kaydedilirken bir hata oluştu: {ex.Message}", "Tamam");
        }
    }

    public void Dispose()
    {
        // Always clean up subscriptions to prevent event memory leaks
    }

}
