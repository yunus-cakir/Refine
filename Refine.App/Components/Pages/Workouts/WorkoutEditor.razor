@page "/workouts/edit/{ProgramId:int}/{WorkoutId:int}"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IJSRuntime JS
@inject WorkoutEditorState EditorState
@inject SelectionStateService SelectionState
@implements IDisposable

@if (_showTopBarMenu)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
    <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
        <div class="refine-dropdown-item position-relative" style="cursor: pointer;">
            <div class="d-flex align-items-center gap-2 w-100">
                <span class="material-symbols-outlined text-[20px]">content_copy</span>
                <span>Copy From Another...</span>
            </div>
            <select class="position-absolute top-0 start-0 w-100 h-100" style="opacity: 0; cursor: pointer; appearance: none;" @onchange="OnWorkoutSelected">
                <option value="0" disabled selected>Import Workout</option>
                @if (_allWorkouts != null)
                {
                    @foreach (var w in _allWorkouts)
                    {
                        <option value="@w.Id">@(w.WorkoutProgram != null ? $"{w.WorkoutProgram.Name} - " : "")@w.Name</option>
                    }
                }
            </select>
        </div>
        <button type="button" class="refine-dropdown-item" @onclick="async () => { ToggleTopBarMenu(); await SaveWorkout(); }">
            <span class="material-symbols-outlined text-[20px]">check</span>
            Save Workout
        </button>
    </div>
}

<div class="page-container py-4 px-0 min-h-screen">
    @if (_isLoading)
    {
        <RfSpinner IsLoading="true"/>
    }
    else
    {
        <EditForm Model="@_workout" OnValidSubmit="SaveWorkout">
            <DataAnnotationsValidator/>


            <RfInput Title="Workout Title" Icon="fitness_center" Placeholder="e.g. Push Day" @bind-Value="_workout.Name"/>

            <RfInput Title="Workout Description" Icon="description" Placeholder="e.g. Chest and Shoulders focus..." Delay="0.05" @bind-Value="_workout.Description"/>

            @if (ProgramId != 0)
            {
                <RfInput Title="Order" Icon="format_list_numbered" Type="number" Delay="0.1" @bind-Value="_workout.Order"/>
            }

            <!-- CNS LOAD -->
            <div class="animate-fade-in" style="animation-delay: 0.15s;">
                <CnsLoadCard Title="Estimated CNS Load" CurrentLoad="TotalCnsLoad" CnsThreshold="CnsThreshold" WarningMessage="High CNS fatigue!"/>
            </div>

            <!-- Add Exercise -->
            <div class="d-flex mb-4 animate-fade-in" style="animation-delay: 0.2s;">
                <button type="button" class="rf-button-primary w-100 fw-bold d-flex justify-content-center align-items-center gap-2" @onclick="GoToExerciseSelection" style="border-radius: 12px; height: 50px;">
                    <span class="material-symbols-outlined">add</span>
                    ADD EXERCISE
                </button>
            </div>

            <div class="text-on-surface-variant small mb-2 text-uppercase fw-bold animate-fade-in" style="letter-spacing: 0.15em; font-size: 11px; animation-delay: 0.25s;">Exercises</div>

            @if (_workout.Items.Any())
            {
                <div class="d-flex flex-column gap-3 mb-5 animate-fade-in" style="animation-delay: 0.3s;">
                    @foreach (var item in _workout.Items.OrderBy(i => i.Order))
                    {
                        <div class="rf-card d-flex flex-column gap-2 exercise-card" style="padding: 12px 16px;">

                            <!-- Header: Order, Name, and Actions -->
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex flex-column">
                                    <span class="fw-bold text-white fs-5">@item.Exercise.Name</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Exercise?.Equipment))
                                    {
                                        <span class="text-on-surface-variant lh-1" style="font-size: 14px; margin-top: 1px;">@item.Exercise.Equipment</span>
                                    }
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm text-white icon-btn" @onclick="() => MoveItemUp(item)" disabled="@(item.Order == 1)">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_upward</span>
                                    </button>
                                    <button type="button" class="btn btn-sm text-white icon-btn" @onclick="() => MoveItemDown(item)" disabled="@(item.Order == _workout.Items.Count)">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_downward</span>
                                    </button>
                                    <button type="button" class="btn btn-sm border-0 ms-1 icon-btn" @onclick="() => RemoveItem(item)">
                                        <span class="material-symbols-outlined" style="font-size: 18px; color: #ff4d4d;">close</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Content: Muscle Groups & Sets -->
                            <div class="d-flex justify-content-between align-items-center mt-1">

                                <!-- Muscle Groups (Ordered by involvement priority) -->
                                <div class="d-flex flex-wrap gap-2 flex-grow-1">
                                    @{
                                        var orderedBadges = new List<(string Name, string Type)>();
                                        if (item.Exercise?.MuscleMaps != null && item.Exercise.MuscleMaps.Any())
                                        {
                                            foreach (var map in item.Exercise.MuscleMaps.OrderByDescending(m => m.ImpactMultiplier))
                                            {
                                                var name = map.MuscleGroup?.Name ?? map.MuscleGroup?.Category;
                                                if (string.IsNullOrEmpty(name)) continue;

                                                string type = "tertiary";
                                                if (map.ImpactMultiplier >= 1.0) type = "primary";
                                                else if (map.ImpactMultiplier >= 0.5) type = "secondary";

                                                if (!orderedBadges.Any(b => b.Name == name))
                                                {
                                                    orderedBadges.Add((name, type));
                                                }
                                            }
                                        }
                                        else if (!string.IsNullOrEmpty(item.Exercise?.PrimaryMuscleCategory))
                                        {
                                            orderedBadges.Add((item.Exercise.PrimaryMuscleCategory, "primary"));
                                        }
                                    }

                                    @foreach (var badge in orderedBadges)
                                    {
                                        @if (badge.Type == "primary")
                                        {
                                            <span class="rf-badge" style="font-size: 10px; padding: 3px 10px;">
                                                @badge.Name
                                            </span>
                                        }
                                        else if (badge.Type == "secondary")
                                        {
                                            <span class="rf-badge" style="font-size: 10px; padding: 3px 10px; color: #ffffff; border-color: rgba(255, 255, 255, 0.4); background-color: rgba(255, 255, 255, 0.1);">
                                                @badge.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="rf-badge-faded" style="font-size: 10px; padding: 3px 10px;">
                                                @badge.Name
                                            </span>
                                        }
                                    }
                                </div>

                                <!-- Sets Control -->
                                <div class="d-flex flex-column align-items-start ms-3">
                                    <div class="text-on-surface-variant small mb-1 text-uppercase fw-bold text-start" style="letter-spacing: 0.1em; font-size: 10px;">Sets</div>
                                    <div class="d-flex align-items-center justify-content-between bg-dark rounded-pill px-1 py-1" style="border: 1px solid rgba(255,255,255,0.05); min-width: 120px;">
                                        <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 32px; height: 32px; background: rgba(255,255,255,0.1);" @onclick="() => { if(item.Sets > 1) item.Sets--; }">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">remove</span>
                                        </button>
                                        <input type="number" class="form-control bg-transparent text-white text-center border-0 fw-bold p-0" style="width: 40px; box-shadow: none;" @bind="item.Sets"/>
                                        <button type="button" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-dark" style="width: 32px; height: 32px; background: #C3F400;" @onclick="() => item.Sets++">
                                            <span class="material-symbols-outlined" style="font-size: 18px;">add</span>
                                        </button>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 rounded mb-4 animate-fade-in" style="border: 1px dashed rgba(255,255,255,0.2); color: rgba(255,255,255,0.4); animation-delay: 0.3s;">
                    No exercises added yet.
                </div>
            }

            <div class="mt-4 px-1 pb-4 animate-fade-in" style="animation-delay: 0.4s;">
                <button type="submit" class="rf-button-primary w-100">
                    <span class="material-symbols-outlined" style="font-size: 20px;">check</span>
                    SAVE WORKOUT
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int ProgramId { get; set; }
    [Parameter] public int WorkoutId { get; set; }

    private Workout _workout = new() { Items = new List<WorkoutItem>() };
    private List<Exercise>? _allExercises;
    private bool _showTopBarMenu = false;
    private bool _isLoading = true;
    private int _selectedWorkoutToCopy;
    private List<Workout>? _allWorkouts;

    private decimal TotalCnsLoad => _workout?.Items?.Sum(i => CalculateItemCnsLoad(i)) ?? 0;
    private decimal CnsThreshold = 150m;
    private decimal PreferredRIR = 2.0m;
    private int PreferredSetCount = 3;

    private decimal CalculateItemCnsLoad(WorkoutItem item)
    {
        decimal baseScore = item.Exercise?.CnsFatigueScore ?? 0m;

        int reps = 10;
        if (!string.IsNullOrWhiteSpace(item.RepsRange))
        {
            var parts = item.RepsRange.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 0 && int.TryParse(parts.Last().Trim(), out int parsedRep))
            {
                reps = parsedRep;
            }
        }

        decimal repMultiplier = reps > 0 ? (reps / 10m) : 1.0m;
        decimal rirMultiplier = 1.0m + ((3.0m - PreferredRIR) * 0.1m);

        return baseScore * item.Sets * repMultiplier * rirMultiplier;
    }


    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        try
        {
            var user = await DbService.GetUserAsync();
            if (user != null)
            {
                CnsThreshold = user.WorkoutSettings.CnsThreshold;
                PreferredRIR = user.WorkoutSettings.PreferredRIR;
                PreferredSetCount = user.WorkoutSettings.PreferredSetCount;
            }

            _allExercises = await DbService.GetExercisesAsync();
            _allWorkouts = await DbService.GetAllWorkoutsWithProgramAsync();

            if (EditorState.IsActive && EditorState.DraftWorkout != null && 
                EditorState.DraftWorkout.Id == WorkoutId && EditorState.DraftWorkout.WorkoutProgramId == ProgramId)
            {
                // Restore from in-memory draft
                _workout = EditorState.DraftWorkout;
            }
            else
            {
                if (WorkoutId != 0)
                {
                    var existing = await DbService.GetWorkoutByIdAsync(WorkoutId);
                    if (existing != null)
                    {
                        _workout = existing;
                    }
                }
                else
                {
                    _workout.WorkoutProgramId = ProgramId;
                    if (ProgramId != 0 && _allWorkouts != null)
                    {
                        var programWorkouts = _allWorkouts.Where(w => w.WorkoutProgramId == ProgramId).ToList();
                        var maxOrder = programWorkouts.Any() ? programWorkouts.Max(w => w.Order) : 0;
                        _workout.Order = maxOrder + 1;
                    }
                }
                EditorState.IsActive = true;
                EditorState.DraftWorkout = _workout;
            }

            // Process pending selections from ExerciseList
            if (SelectionState.IsActive && SelectionState.SelectedIds.Any())
            {
                int orderBase = _workout.Items.Count > 0 ? _workout.Items.Max(i => i.Order) : 0;
                foreach (var exId in SelectionState.SelectedIds)
                {
                    var exercise = _allExercises?.FirstOrDefault(e => e.Id == exId);
                    if (exercise != null)
                    {
                        _workout.Items.Add(new WorkoutItem
                        {
                            ExerciseId = exercise.Id,
                            Exercise = exercise,
                            Sets = PreferredSetCount,
                            RepsRange = "10",
                            Order = ++orderBase
                        });
                    }
                }
                SelectionState.Clear();
            }

            TopBar.SetDetailMode(WorkoutId == 0 ? "New Workout" : "Edit Workout");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    private bool _isNavigatingAwayForSelection = false;

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
        if (!_isNavigatingAwayForSelection)
        {
            EditorState.Clear();
        }
    }

    private async Task GoToExerciseSelection()
    {
        if (string.IsNullOrWhiteSpace(_workout.Name))
        {
            await UiHelper.ShowAlert("Validation", "Please enter a workout title before adding exercises.", "OK");
            return;
        }

        // Save current draft to memory and prepare return state
        EditorState.DraftWorkout = _workout;
        EditorState.IsActive = true;
        
        SelectionState.ReturnUrl = $"/workouts/edit/{ProgramId}/{WorkoutId}";
        SelectionState.SelectedIds.Clear();
        SelectionState.IsActive = false;

        _isNavigatingAwayForSelection = true;
        NavManager.NavigateTo($"/exercises?selection=true");
    }

    private async Task ImportFromWorkout()
    {
        if (_selectedWorkoutToCopy == 0) return;
        var sourceWorkout = await DbService.GetWorkoutByIdAsync(_selectedWorkoutToCopy);
        if (sourceWorkout?.Items != null)
        {
            int orderBase = _workout.Items.Count > 0 ? _workout.Items.Max(i => i.Order) : 0;
            foreach (var item in sourceWorkout.Items)
            {
                _workout.Items.Add(new WorkoutItem
                {
                    ExerciseId = item.ExerciseId,
                    Exercise = item.Exercise,
                    Sets = item.Sets,
                    RepsRange = item.RepsRange,
                    Order = ++orderBase
                });
            }
        }

        _selectedWorkoutToCopy = 0;
    }

    private async Task OnWorkoutSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id) && id > 0)
        {
            _selectedWorkoutToCopy = id;
            await ImportFromWorkout();
        }

        ToggleTopBarMenu();
    }

    private void RemoveItem(WorkoutItem item)
    {
        _workout.Items.Remove(item);

        int newOrder = 1;
        foreach (var i in _workout.Items.OrderBy(x => x.Order))
        {
            i.Order = newOrder++;
        }
    }

    private void MoveItemUp(WorkoutItem item)
    {
        var previousItem = _workout.Items.FirstOrDefault(i => i.Order == item.Order - 1);

        if (previousItem != null)
        {
            previousItem.Order++;
            item.Order--;
        }
    }

    private void MoveItemDown(WorkoutItem item)
    {
        var nextItem = _workout.Items.FirstOrDefault(i => i.Order == item.Order + 1);

        if (nextItem != null)
        {
            nextItem.Order--;
            item.Order++;
        }
    }

    private async Task SaveWorkout()
    {
        if (string.IsNullOrWhiteSpace(_workout.Name)) return;
        await DbService.SaveWorkoutWithItemsAsync(_workout);
        EditorState.Clear();
        await GoBack();
    }

    private async Task GoBack()
    {
        EditorState.Clear();
        await JS.InvokeVoidAsync("history.back");
    }

}