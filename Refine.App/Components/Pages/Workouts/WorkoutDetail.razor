@page "/workouts/detail/{id:int}"
@using Refine.App.Models
@using Refine.App.Services
@implements IDisposable
@inject LocalDbService ProgramService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IJSRuntime JS

@if (_workout == null)
{
    <div class="loader-container">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="workout-detail-container">
        
        <!-- Target Muscles -->
        <section class="section-margin">
            <h2 class="font-title-sm text-title-sm target-muscles-title">Target Muscles</h2>
            <div class="muscle-badges-container">
                @if (_workout.Items != null)
                {
                    var targetMuscles = _workout.Items
                        .Where(i => !string.IsNullOrWhiteSpace(i.Exercise?.PrimaryMuscleCategory))
                        .Select(i => i.Exercise!.PrimaryMuscleCategory!.ToUpper())
                        .Distinct()
                        .ToList();
                    
                    if (targetMuscles.Any())
                    {
                        foreach (var muscle in targetMuscles)
                        {
                            <span class="refine-badge">@muscle</span>
                        }
                    }
                    else
                    {
                        <span class="refine-badge">GENEL</span>
                    }
                }
            </div>
        </section>

        <!-- Start Button -->
        <div class="button-container section-margin">
            <button class="refine-glow-btn-lg" @onclick="StartWorkout">
                START WORKOUT
            </button>
        </div>

        <!-- CNS YÜKÜ PROGRESS BAR -->
        <div class="cns-container section-margin">
            @{
                var percentage = CnsThreshold > 0 ? Math.Min((TotalCnsLoad / CnsThreshold) * 100, 100) : 0;
                var dynamicColor = Refine.App.Services.CnsHelper.GetCnsColor(percentage);
            }
            <div class="cns-header">
                <span class="font-label text-label-caps cns-label">CNS Yorgunluk Yükü (Tahmini)</span>
                <span class="font-label text-label-caps" style="color: @dynamicColor;">
                    %@percentage.ToString("0")
                </span>
            </div>
            <div class="cns-progress-track">
                <div class="cns-progress-fill" style="width: @percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @dynamicColor;"></div>
            </div>
            @if (TotalCnsLoad >= CnsThreshold)
            {
                <div class="cns-warning" style="border-left: 4px solid @dynamicColor; color: @dynamicColor;">
                    <i class="bi bi-exclamation-triangle-fill cns-warning-icon"></i>
                    <div class="font-body text-body-md">
                        <strong>Severe CNS Fatigue!</strong> This program may overtax your nervous system.
                    </div>
                </div>
            }
        </div>


        <!-- Exercises List -->
        <section class="exercises-section">
            @if (_workout.Items != null)
            {
                @foreach (var item in _workout.Items.OrderBy(i => i.Order))
                {
                    <article class="refine-card exercise-card">
                        <div class="exercise-card-content">
                            <div class="exercise-icon-container">
                                <span class="material-symbols-outlined exercise-icon" style="font-variation-settings: 'FILL' 0;">fitness_center</span>
                            </div>
                            <div class="exercise-details">
                                <div class="exercise-header">
                                    <h3 class="font-title-sm text-title-sm exercise-title">@(item.Exercise?.Name ?? "Bilinmeyen Hareket")</h3>
                                    <span class="material-symbols-outlined exercise-more-icon">more_vert</span>
                                </div>
                                <div class="exercise-stats font-body text-body-md">
                                    <span class="stat-item"><span class="material-symbols-outlined stat-icon">repeat</span> @item.Sets Sets</span>
                                    <span class="stat-divider">•</span>
                                    <span class="stat-item"><span class="material-symbols-outlined stat-icon">fitness_center</span> @item.RepsRange Reps</span>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Workout? _workout;

    private decimal TotalCnsLoad => _workout?.Items?.Sum(i => CalculateItemCnsLoad(i)) ?? 0;
    private decimal CnsThreshold = 150m;
    private int PreferredRIR = 2;

    private decimal CalculateItemCnsLoad(WorkoutItem item)
    {
        decimal baseScore = item.Exercise?.CnsFatigueScore ?? 0m;
        
        int reps = 10;
        if (!string.IsNullOrWhiteSpace(item.RepsRange))
        {
            var parts = item.RepsRange.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 0 && int.TryParse(parts.Last().Trim(), out int parsedRep))
            {
                reps = parsedRep;
            }
        }
        
        decimal repMultiplier = reps > 0 ? (reps / 10m) : 1.0m;
        decimal rirMultiplier = 1.0m + ((3m - PreferredRIR) * 0.1m);
        
        return baseScore * item.Sets * repMultiplier * rirMultiplier;
    }

    protected override void OnInitialized()
    {
        TopBar.OnLeftActionTapped += HandleLeftAction;
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await ProgramService.GetUserAsync();
        if (user != null)
        {
            CnsThreshold = user.WorkoutSettings.CnsThreshold;
            PreferredRIR = user.WorkoutSettings.PreferredRIR;
        }

        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode(_workout.Name);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode(_workout.Name);
        }
    }

    private async void HandleLeftAction()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private void HandleRightAction()
    {
        // Settings / Options popup logic here
        Console.WriteLine("Right action tapped from MAUI header!");
    }

    public void Dispose()
    {
        TopBar.OnLeftActionTapped -= HandleLeftAction;
        TopBar.OnRightActionTapped -= HandleRightAction;
    }

    // YENİ METOT: Başlatma Mantığı
    private async Task StartWorkout()
    {
        // Bugün için kayıt var mı kontrol et (LocalDbService'e eklediğin metod)
        bool exists = await ProgramService.HasLogForTodayAsync(Id);

        if (exists)
        {
            // Varsa: "resuming=true" parametresiyle git
            NavManager.NavigateTo($"/session/active/{Id}?resuming=true");
        }
        else
        {
            // Yoksa: Normal git
            NavManager.NavigateTo($"/session/active/{Id}");
        }
    }
}