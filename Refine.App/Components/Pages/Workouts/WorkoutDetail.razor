@page "/workouts/detail/{id:int}"
@using Refine.App.Models
@using Refine.App.Services
@implements IDisposable
@inject LocalDbService ProgramService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IJSRuntime JS

@if (_workout == null)
{
    <div class="loader-container">
        <div class="spinner-border" style="color: var(--color-primary-container);"></div>
    </div>
}
else
{
    @if (_showTopBarMenu)
    {
        <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
        <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
            <button class="refine-dropdown-item" @onclick="() => { ToggleTopBarMenu(); EditWorkout(); }">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                Edit Workout
            </button>
        </div>
    }

    <div class="workout-detail-container">

        <!-- Target Muscles -->
        <section class="section-margin">
            <h2 class="font-body target-muscles-title">Target Muscles</h2>
            <div class="muscle-badges-container">
                @if (_workout.Items != null)
                {
                    var targetMuscles = _workout.Items
                        .Where(i => !string.IsNullOrWhiteSpace(i.Exercise?.PrimaryMuscleCategory))
                        .Select(i => i.Exercise!.PrimaryMuscleCategory!.ToUpper())
                        .Distinct()
                        .ToList();

                    if (targetMuscles.Any())
                    {
                        foreach (var muscle in targetMuscles)
                        {
                            <span class="refine-badge">@muscle</span>
                        }
                    }
                    else
                    {
                        <span class="refine-badge">GENERAL</span>
                    }
                }
            </div>
        </section>

        <!-- Start Button -->
        <div class="button-container section-margin">
            <button class="rf-button-secondary" @onclick="StartWorkout">
                START WORKOUT
            </button>
        </div>

        <!-- CNS YÜKÜ PROGRESS BAR -->
        <div class="cns-container section-margin">
            <CnsLoadCard Title="Estimated CNS Load" CurrentLoad="TotalCnsLoad" CnsThreshold="CnsThreshold" WarningMessage="Severe CNS Fatigue! This program may overtax your nervous system." CssClass="m-0" />
        </div>


        <!-- Exercises List -->
        <section class="exercises-section">
            @if (_workout.Items != null)
            {
                @foreach (var item in _workout.Items.OrderBy(i => i.Order))
                {
                    <article class="rf-card exercise-card">
                        <div class="exercise-card-content">
                            <div class="exercise-icon-container">
                                <span class="material-symbols-outlined exercise-icon" style="font-variation-settings: 'FILL' 0;">fitness_center</span>
                            </div>
                            <div class="exercise-details">
                                <div class="exercise-header">
                                    <h3 class="font-body exercise-title">@(item.Exercise?.Name ?? "Bilinmeyen Hareket")</h3>
                                </div>
                                <div class="exercise-stats font-body">
                                    <span class="stat-item"><span class="material-symbols-outlined stat-icon">repeat</span> @item.Sets Sets</span>
                                    @if (!string.IsNullOrWhiteSpace(item.RepsRange) && !item.RepsRange.Equals("Failure", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="stat-divider">•</span>
                                        <span class="stat-item"><span class="material-symbols-outlined stat-icon">fitness_center</span> @item.RepsRange Reps</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            }
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Cycle { get; set; }
    private Workout? _workout;

    private decimal TotalCnsLoad => _workout?.Items?.Sum(i => CalculateItemCnsLoad(i)) ?? 0;
    private decimal CnsThreshold = 150m;
    private decimal PreferredRIR = 2.0m;

    private decimal CalculateItemCnsLoad(WorkoutItem item)
    {
        decimal baseScore = item.Exercise?.CnsFatigueScore ?? 0m;

        int reps = 10;
        if (!string.IsNullOrWhiteSpace(item.RepsRange))
        {
            var parts = item.RepsRange.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 0 && int.TryParse(parts.Last().Trim(), out int parsedRep))
            {
                reps = parsedRep;
            }
        }

        decimal repMultiplier = reps > 0 ? (reps / 10m) : 1.0m;
        decimal rirMultiplier = 1.0m + ((3.0m - PreferredRIR) * 0.1m);

        return baseScore * item.Sets * repMultiplier * rirMultiplier;
    }

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await ProgramService.GetUserAsync();
        if (user != null)
        {
            CnsThreshold = user.WorkoutSettings.CnsThreshold;
            PreferredRIR = user.WorkoutSettings.PreferredRIR;
        }

        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode(_workout.Name);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode(_workout.Name);
        }
    }


    private bool _showTopBarMenu = false;

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void EditWorkout()
    {
        if (_workout != null)
        {
            NavManager.NavigateTo($"/workouts/edit/{_workout.WorkoutProgramId}/{_workout.Id}");
        }
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
    }

    // YENİ METOT: Başlatma Mantığı
    private async Task StartWorkout()
    {
        // Bugün için belirtilen cycle'da kayıt var mı kontrol et
        bool exists = await ProgramService.HasLogForTodayAsync(Id, Cycle);

        string cycleQuery = Cycle.HasValue ? $"&cycle={Cycle.Value}" : "";
        string baseQuery = Cycle.HasValue ? $"?cycle={Cycle.Value}" : "";

        if (exists)
        {
            // Varsa: "resuming=true" parametresiyle git
            NavManager.NavigateTo($"/session/active/{Id}?resuming=true{cycleQuery}");
        }
        else
        {
            // Yoksa: Normal git
            NavManager.NavigateTo($"/session/active/{Id}{baseQuery}");
        }
    }

}