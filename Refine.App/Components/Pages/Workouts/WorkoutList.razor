@page "/workouts"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@implements IDisposable

@if (_showTopBarMenu)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
    <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
        <button class="refine-dropdown-item" @onclick="() => { ToggleTopBarMenu(); GoToPrograms(); }">
            <span class="material-symbols-outlined text-[20px]">list_alt</span>
            Show All Programs
        </button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0">Antrenmanlar</h3>
</div>

@if (_isLoading)
{
    <div class="text-center"><div class="spinner-border text-primary"></div></div>
}
else if (_selectedProgram == null)
{
    <div class="text-center text-muted mt-5">
        <i class="bi bi-journal-x fs-1 d-block mb-3"></i>
        <p>You don't have a selected Workout Program.</p>
        <button class="btn btn-primary mt-2" @onclick="GoToPrograms">Select Program</button>
    </div>
}
else if (_selectedProgram.Workouts == null || !_selectedProgram.Workouts.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="bi bi-journal-plus fs-1 d-block mb-3"></i>
        <p>Seçili programda henüz antrenman bulunmuyor.</p>
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge bg-primary">Seçili Program: @_selectedProgram.Name</span>
    </div>

    <div class="d-flex flex-column gap-3 pb-5">
        @foreach (var workout in _selectedProgram.Workouts.OrderBy(w => w.Order))
        {
            <div class="refine-card p-3">
                <div class="d-flex align-items-center justify-content-between">

                    <a href="@($"/workouts/detail/{workout.Id}")" class="text-decoration-none text-white flex-grow-1">
                        <div class="d-flex align-items-center">
                            <div class="bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 45px; height: 45px;">
                                <i class="bi bi-lightning-charge-fill text-warning"></i>
                            </div>

                            <div>
                                <h6 class="fw-bold mb-0">@workout.Name</h6>
                                <small class="text-muted" style="font-size: 0.8rem;">
                                    @(workout.Items?.Count ?? 0) Hareket • @(string.IsNullOrEmpty(workout.Description) ? "Program İdmanı" : workout.Description)
                                </small>
                            </div>
                        </div>
                    </a>

                </div>
            </div>
        }
    </div>
}

@code {
    private WorkoutProgram? _selectedProgram;
    private bool _isLoading = true;
    private bool _showTopBarMenu = false;

    protected override void OnInitialized()
    {
        TopBar.OnLeftActionTapped += HandleLeftAction;
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetDetailMode("My Workouts");
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _selectedProgram = await DbService.GetSelectedWorkoutProgramAsync();
        _isLoading = false;
    }

    private void GoToPrograms()
    {
        NavManager.NavigateTo("/programs");
    }

    private void HandleLeftAction()
    {
        NavManager.NavigateTo("/");
    }

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TopBar.OnLeftActionTapped -= HandleLeftAction;
        TopBar.OnRightActionTapped -= HandleRightAction;

        var nextUri = NavManager.Uri;
        if (nextUri.Contains("/workouts/detail/") || 
            nextUri.Contains("/session/active/") || 
            nextUri.Contains("/session/edit/"))
        {
            return;
        }

        if (TopBar.CurrentConfig.Title == "My Workout")
        {
            TopBar.SetHomeMode(string.Empty);
        }
    }
}