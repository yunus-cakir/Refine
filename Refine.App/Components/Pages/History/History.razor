@page "/history"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IJSRuntime JS

@if (_sessions == null)
{
    <RfSpinner IsLoading="true" />
}
else if (!_sessions.Any())
{
    <div class="text-center text-muted mt-5 animate-fade-in">
        <i class="bi bi-clock-history fs-1 d-block mb-3"></i>
        <p>Henüz tamamlanmış antrenman yok.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3 pb-5 animate-fade-in">
        @foreach (var session in _sessions)
        {
            <article class="rf-card rf-card-bordered" style="cursor: pointer;" @onclick="() => GoToDetail(session)">
                <div class="rf-card-border-completed"></div>

                <div class="rf-card-bordered-content">
                    <!-- Header: Small Date in top-left -->
                    <header class="font-label" style="font-size: 11px; color: var(--color-on-surface-variant); margin-bottom: 6px; font-weight: bold; letter-spacing: 0.05em; text-transform: uppercase;">
                        @session.Date.ToString("dd MMM yyyy")
                    </header>

                    <!-- Workout Name -->
                    <h3 class="font-headline" style="color: var(--color-primary-fixed); font-size: 20px; font-weight: bold; margin-top: 0; margin-bottom: 8px;">
                        @session.WorkoutName
                    </h3>

                    <!-- Divider -->
                    <div style="height: 1px; background-color: rgba(255, 255, 255, 0.05); margin-top: 8px; margin-bottom: 12px; margin-left: -24px; margin-right: -20px;"></div>

                    <!-- Bottom row -->
                    <div class="rf-flex-row rf-justify-between rf-items-center">
                        <!-- Stats -->
                        <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-on-surface-variant); font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                            <span class="material-symbols-outlined" style="font-size: 16px;">fitness_center</span>
                            @session.TotalExercises EXERCISES • @session.TotalSets SETS
                        </div>

                        <!-- Status -->
                        <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-primary-fixed); font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                            COMPLETED
                            <span class="material-symbols-outlined" style="font-size: 20px; font-variation-settings: 'FILL' 1;">check_circle</span>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}

@code {
    // Ekranda göstermek için kullanacağımız yardımcı model (ViewModel)
    private class SessionViewModel
    {
        public DateTime Date { get; set; }
        public int WorkoutId { get; set; }
        public string WorkoutName { get; set; } = "Bilinmiyor";
        public int TotalSets { get; set; }
        public int TotalExercises { get; set; }
    }

    private List<SessionViewModel>? _sessions;



    protected override async Task OnInitializedAsync()
    {
        TopBar.SetDetailMode("History");
        // 1. Tüm logları çek
        var allLogs = await DbService.GetAllLogsAsync();
        // 3. Logları GRUPLA: Aynı gün ve aynı antrenman ID'sine sahip olanlar bir seanstır.
        // GroupBy: Date.Date (Sadece gün kısmı) ve WorkoutId
        var grouped = allLogs.GroupBy(l => new { l.Date.Date, l.WorkoutId })
                             .Select(g => new SessionViewModel
                             {
                                 Date = g.Key.Date,
                                 WorkoutId = g.Key.WorkoutId,
                                 TotalSets = g.Count(),
                                 TotalExercises = g.Select(x => x.ExerciseId).Distinct().Count()
                             })
                             .OrderByDescending(s => s.Date)
                             .ToList();

        // 4. İsimleri Bul (N+1 Sorunu olmaması için basit bir cache mantığı)
        foreach (var session in grouped)
        {
            var w = await DbService.GetWorkoutByIdAsync(session.WorkoutId);
            if (w != null)
            {
                session.WorkoutName = w.Name;
            }
            else
            {
                session.WorkoutName = "Silinmiş Antrenman";
            }
        }

        _sessions = grouped;
    }

    private void GoToDetail(SessionViewModel session)
    {
        // Tarihi URL'de taşımak için Ticks (sayısal zaman damgası) kullanıyoruz.
        NavManager.NavigateTo($"/history/detail/{session.WorkoutId}/{session.Date.Ticks}");
    }


}