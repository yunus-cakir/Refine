@page "/history"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0">Geçmiş</h3>
</div>

@if (_sessions == null)
{
    <div class="text-center"><div class="spinner-border text-primary"></div></div>
}
else if (!_sessions.Any())
{
    <div class="text-center text-muted mt-5">
        <i class="bi bi-clock-history fs-1 d-block mb-3"></i>
        <p>Henüz tamamlanmış antrenman yok.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3 pb-5">
        @foreach (var session in _sessions)
        {
            <div class="refine-card p-3" @onclick="() => GoToDetail(session)">
                <div class="d-flex justify-content-between align-items-center">

                    <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-25 rounded-3 d-flex flex-column align-items-center justify-content-center me-3 px-2 py-1"
                             style="min-width: 55px;">
                            <span class="fw-bold fs-5">@session.Date.Day</span>
                            <small class="text-uppercase" style="font-size: 0.7rem;">@session.Date.ToString("MMM")</small>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1">@session.WorkoutName</h6>
                            <small class="text-muted">
                                @session.TotalSets Set • @session.TotalExercises Hareket
                            </small>
                        </div>
                    </div>

                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
            </div>
        }
    </div>
}

@code {
    // Ekranda göstermek için kullanacağımız yardımcı model (ViewModel)
    private class SessionViewModel
    {
        public DateTime Date { get; set; }
        public int WorkoutId { get; set; }
        public string WorkoutName { get; set; } = "Bilinmiyor";
        public int TotalSets { get; set; }
        public int TotalExercises { get; set; }
    }

    private List<SessionViewModel>? _sessions;

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetStandardMode("Analytics");
        // 1. Tüm logları çek
        var allLogs = await DbService.GetAllLogsAsync();

        // 2. Tüm antrenman tanımlarını çek (İsimleri eşleştirmek için)
        // Not: Performans için normalde bu Join ile yapılır ama şimdilik kod tarafında yapalım.
        var standaloneWorkouts = await DbService.GetStandaloneWorkoutsAsync();
        var programs = await DbService.GetAllProgramsAsync();

        // Program içindeki workoutları da düz bir listeye alalım
        var allWorkouts = new List<Workout>();
        allWorkouts.AddRange(standaloneWorkouts);
        foreach (var p in programs)
        {
            // Program detaylarını çekmemiz gerekebilir, şimdilik basit tutalım.
            // GetAllProgramsAsync detayları getirmiyorsa, loglardaki ID'den bulmaya çalışacağız.
            // En garantisi: Log listesindeki Unique WorkoutID'leri alıp tek tek sorgulamaktır.
        }


        // 3. Logları GRUPLA: Aynı gün ve aynı antrenman ID'sine sahip olanlar bir seanstır.
        // GroupBy: Date.Date (Sadece gün kısmı) ve WorkoutId
        var grouped = allLogs.GroupBy(l => new { l.Date.Date, l.WorkoutId })
                             .Select(g => new SessionViewModel
                             {
                                 Date = g.Key.Date,
                                 WorkoutId = g.Key.WorkoutId,
                                 TotalSets = g.Count(),
                                 TotalExercises = g.Select(x => x.ExerciseId).Distinct().Count()
                             })
                             .OrderByDescending(s => s.Date)
                             .ToList();

        // 4. İsimleri Bul (N+1 Sorunu olmaması için basit bir cache mantığı)
        foreach (var session in grouped)
        {
            var w = await DbService.GetWorkoutByIdAsync(session.WorkoutId);
            if (w != null)
            {
                session.WorkoutName = w.Name;
            }
            else
            {
                session.WorkoutName = "Silinmiş Antrenman";
            }
        }

        _sessions = grouped;
    }

    private void GoToDetail(SessionViewModel session)
    {
        // Tarihi URL'de taşımak için Ticks (sayısal zaman damgası) kullanıyoruz.
        NavManager.NavigateTo($"/history/detail/{session.WorkoutId}/{session.Date.Ticks}");
    }

    public void Dispose()
    {
        var nextUri = NavManager.Uri;
        if (nextUri.Contains("/workouts/detail/") || 
            nextUri.Contains("/session/active/") || 
            nextUri.Contains("/session/edit/"))
        {
            return;
        }

        if (TopBar.CurrentConfig.Title == "Analytics")
        {
            TopBar.SetHomeMode(string.Empty);
        }
    }
}