@page "/history/detail/{WorkoutId:int}/{DateTicks:long}"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject RecoveryService RecService
@inject IJSRuntime JS
@implements IDisposable

@if (_logsGrouped == null)
{
    <RfSpinner IsLoading="true" />
}
else
{
<div class="animate-fade-in">
    @if (_showTopBarMenu)
    {
        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; background: transparent;" @onclick="ToggleTopBarMenu"></div>
        <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
            <button class="refine-dropdown-item" @onclick="() => { ToggleTopBarMenu(); EditWorkoutLog(); }">
                <span class="material-symbols-outlined" style="font-size: 20px;">edit</span>
                Edit Workout Log
            </button>
        </div>
    }

    <div class="mb-4">
        <h3 class="font-headline" style="font-size: 20px; font-weight: bold; margin-top: 0; margin-bottom: 4px;">
            @_workoutName
        </h3>
        <div class="text-muted font-label" style="font-size: 13px; font-weight: bold; letter-spacing: 0.05em; text-transform: uppercase;">
            @_sessionDate.ToString("dd MMMM yyyy, dddd")
        </div>
        @if (_targetMuscles != null)
        {
            <div class="d-flex flex-wrap gap-1 mt-2">
                @if (_targetMuscles.Any())
                {
                    @foreach (var muscle in _targetMuscles)
                    {
                        <span class="refine-badge">@muscle</span>
                    }
                }
                else
                {
                    <span class="refine-badge">GENERAL</span>
                }
            </div>
        }
    </div>

    <CnsLoadCard CurrentLoad="TotalActualCnsLoad" CnsThreshold="CnsThreshold"/>

    <div style="margin-bottom: 16px;">
        <MuscleFatigueList Fatigues="_workoutFatigues" Title="Muscle Impact" EmptyMessage="No muscle volume recorded." Preset="GradientPreset.MuscleImpact"/>
    </div>

    <div class="history-section mt-4 pb-5">
        <h5 class="font-headline fw-bold mb-3">Exercises</h5>
        @foreach (var exerciseGroup in _logsGrouped)
        {
            <div class="mb-4">
                <div class="small fw-bold text-muted mb-2 ms-1">@exerciseGroup.ExerciseName</div>
                <div class="refine-card p-3">
                    <div class="row g-2 mb-2 text-muted small fw-bold text-center border-bottom border-secondary pb-1">
                        <div class="col-2">SET</div>
                        <div class="col-3">WEIGHT</div>
                        <div class="col-3">REPS</div>
                        <div class="col-2">RIR</div>
                        <div class="col-2">FORM</div>
                    </div>

                    @foreach (var log in exerciseGroup.Logs)
                    {
                        <div class="row g-2 mb-2 align-items-center text-center">
                            <div class="col-2">
                                <span class="badge bg-secondary rounded-circle" style="width:24px; height:24px; display: inline-flex; align-items: center; justify-content: center;">@log.SetNumber</span>
                            </div>

                            <div class="col-3 fw-bold text-white">@(log.Weight.HasValue ? log.Weight : "-")</div>
                            <div class="col-3 fw-bold text-white">@(log.Reps.HasValue ? log.Reps : "-")</div>

                            <div class="col-2 text-warning">@(log.RIR.HasValue ? log.RIR : "-")</div>

                            <div class="col-2 text-center">
                                @if (log.FormRating == 3)
                                {
                                    <i class="bi bi-fire" style="color: #ff0055;"></i>
                                }
                                else if (log.FormRating == 2)
                                {
                                    <i class="bi bi-emoji-smile-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-emoji-neutral-fill text-warning"></i>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
}

@code {
    [Parameter] public int WorkoutId { get; set; }
    [Parameter] public long DateTicks { get; set; }

    private DateTime _sessionDate;
    private string _workoutName = "";
    private List<string> _targetMuscles = new();

    private bool _showTopBarMenu = false;

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void EditWorkoutLog()
    {
        NavManager.NavigateTo($"/session/edit/{WorkoutId}/{DateTicks}");
    }

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    // Egzersiz bazlı gruplama için yardımcı sınıf
    private class ExerciseHistoryGroup
    {
        public string ExerciseName { get; set; } = "";
        public decimal BaseCnsScore { get; set; } = 0;
        public List<WorkoutLog> Logs { get; set; } = new();
    }

    private List<ExerciseHistoryGroup>? _logsGrouped;
    private List<MuscleFatigueInfo>? _workoutFatigues;
    private decimal CnsThreshold = 150m;
    private decimal PreferredRIR = 2.0m;

    private decimal TotalActualCnsLoad => _logsGrouped?.Sum(g =>
        g.Logs.Sum(l =>
            CalculateLogCnsLoad(l, g.BaseCnsScore)
        )
    ) ?? 0;

    private decimal CalculateLogCnsLoad(WorkoutLog log, decimal baseScore)
    {
        int reps = log.Reps ?? 10;
        decimal rir = (decimal?)log.RIR ?? PreferredRIR;

        decimal repMultiplier = reps > 0 ? (reps / 10m) : 1.0m;
        decimal rirMultiplier = 1.0m + ((3m - rir) * 0.1m);

        return baseScore * 1 /* 1 set */ * repMultiplier * rirMultiplier;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await DbService.GetUserAsync();
        if (user != null)
        {
            CnsThreshold = user.WorkoutSettings.CnsThreshold;
            PreferredRIR = user.WorkoutSettings.PreferredRIR;
        }

        // Ticks'i tekrar DateTime'a çevir
        _sessionDate = new DateTime(DateTicks);

        // 1. Antrenman ismini bul
        var workout = await DbService.GetWorkoutByIdAsync(WorkoutId);
        _workoutName = workout?.Name ?? "Silinmiş Antrenman";
        TopBar.SetDetailMode(_sessionDate.ToString("d MMMM yyyy"));

        // 2. O güne ait logları çek
        var logs = await DbService.GetSessionLogsAsync(WorkoutId, _sessionDate);

        // 3. Egzersizlere göre grupla (Join işlemi ile isimleri alarak)
        var allExercises = await DbService.GetExercisesAsync();

        _logsGrouped = logs.GroupBy(l => l.ExerciseId)
            .Select(g =>
            {
                var ex = allExercises.FirstOrDefault(e => e.Id == g.Key);
                return new ExerciseHistoryGroup
                {
                    ExerciseName = ex?.Name ?? "Bilinmeyen Hareket",
                    BaseCnsScore = ex?.CnsFatigueScore ?? 0m,
                    Logs = g.OrderBy(l => l.SetNumber).ToList()
                };
            })
            .ToList();

        _targetMuscles = logs
            .Select(l => allExercises.FirstOrDefault(e => e.Id == l.ExerciseId))
            .Where(ex => ex != null && !string.IsNullOrWhiteSpace(ex.PrimaryMuscleCategory))
            .Select(ex => ex!.PrimaryMuscleCategory!.ToUpper())
            .Distinct()
            .ToList();

        _workoutFatigues = RecService.CalculateMuscleFatigue(logs, allExercises, true);
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
    }

}