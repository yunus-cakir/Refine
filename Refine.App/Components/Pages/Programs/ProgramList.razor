@page "/programs"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService ProgramService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IPopupService PopupService
@implements IDisposable

@if (_programs == null)
{
    <RfSpinner IsLoading="true"/>
}
else
{
    <div class="workout-detail-container animate-fade-in">
        <div class="rf-flex-row rf-justify-between rf-items-center" style="margin-bottom: 24px;">
            <a href="/programs/edit/0" class="rf-button-inverse" style="padding: 8px 16px; border-radius: 9999px; font-size: 12px; display: flex; align-items: center; gap: 8px; text-decoration: none;">
                <span class="material-symbols-outlined" style="font-size: 16px;">add</span>
                NEW
            </a>
        </div>

        @if (_programs.Count == 0)
        {
            <div class="rf-flex-col rf-items-center" style="gap: 16px; margin-top: 48px; text-align: center; opacity: 0.5;">
                <span class="material-symbols-outlined" style="font-size: 48px; color: var(--color-on-surface-variant);">event_note</span>
                <p class="font-body" style="color: var(--color-on-surface-variant);">Henüz kayıtlı bir program yok.</p>
            </div>
        }
        else
        {
            @if (_activeCardMenuId.HasValue)
            {
                <div class="fixed inset-0 z-40" @onclick="() => _activeCardMenuId = null"></div>
            }

            <div class="rf-flex-col" style="gap: 16px; padding-bottom: 80px;">
                @foreach (var program in _programs)
                {
                    <div class="refine-card" style="position: relative; overflow: @(_activeCardMenuId == program.Id ? "visible" : "hidden"); padding: 0; z-index: @(_activeCardMenuId == program.Id ? "45" : "1");">
                        <!-- Highlight border -->
                        <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background-color: @(_selectedProgramId == program.Id ? "var(--color-primary-fixed)" : "#ffffff"); border-top-left-radius: inherit; border-bottom-left-radius: inherit;"></div>

                        <RfCardMenu Id="program.Id" @bind-ActiveMenuId="_activeCardMenuId">
                            @if (_selectedProgramId != program.Id)
                            {
                                <button class="card-dropdown-item" @onclick="() => SelectProgram(program)" @onclick:preventDefault @onclick:stopPropagation>
                                    <span class="material-symbols-outlined">radio_button_unchecked</span>
                                    Make Selected
                                </button>
                            }
                            else
                            {
                                <div class="card-dropdown-item" style="color: var(--color-primary-fixed); opacity: 0.8; cursor: default;">
                                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                    Selected Program
                                </div>
                            }
                            <button class="card-dropdown-item" @onclick="() => EditProgramItem(program)" @onclick:preventDefault @onclick:stopPropagation>
                                <span class="material-symbols-outlined">edit</span>
                                Edit Program
                            </button>
                            <button class="card-dropdown-item delete-btn" @onclick="() => DeleteProgram(program)" @onclick:preventDefault @onclick:stopPropagation>
                                <span class="material-symbols-outlined">close</span>
                                Delete Program
                            </button>
                        </RfCardMenu>

                        <NavLink href="@($"/programs/{program.Id}")" style="display: block; padding: 20px 20px 20px 24px; text-decoration: none;">
                            <div style="padding-right: 40px;">
                                <h5 class="font-headline" style="color: var(--color-primary); font-size: 20px; font-weight: bold; margin-bottom: 8px;">@program.Name</h5>

                                <div class="rf-flex-row rf-items-center" style="gap: 8px; margin-bottom: 16px;">
                                    <span class="refine-badge">@program.Level.ToUpper()</span>
                                </div>
                            </div>

                            <div class="rf-flex-row rf-items-center font-label" style="gap: 8px; font-size: 11px; color: var(--color-on-surface-variant); text-transform: uppercase; letter-spacing: 0.1em; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 12px; margin-top: 4px;">
                                <span class="material-symbols-outlined" style="font-size: 16px;">emoji_events</span>
                                @program.Goal
                            </div>
                        </NavLink>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<WorkoutProgram>? _programs;
    private int? _activeCardMenuId;
    private int? _selectedProgramId;

    protected override void OnInitialized()
    {
    }

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetDetailMode("Programs");
        await LoadData();
    }

    private async Task LoadData()
    {
        var allPrograms = await ProgramService.GetAllProgramsAsync();
        var selected = await ProgramService.GetSelectedWorkoutProgramAsync();
        _selectedProgramId = selected?.Id;

        if (allPrograms != null)
        {
            _programs = allPrograms
                .OrderByDescending(p => p.Id == _selectedProgramId)
                .ThenByDescending(p => p.Cycle)
                .ThenBy(p => p.Name)
                .ToList();
        }
        else
        {
            _programs = null;
        }
    }

    private async Task SelectProgram(WorkoutProgram program)
    {
        _activeCardMenuId = null;
        await ProgramService.SetSelectedWorkoutProgramAsync(program.Id);
        await LoadData();
    }

    private void EditProgramItem(WorkoutProgram program)
    {
        NavManager.NavigateTo($"/programs/edit/{program.Id}");
    }

    private async Task DeleteProgram(WorkoutProgram program)
    {
        _activeCardMenuId = null;
        var result = await PopupService.ShowAsync(new PopupOptions
        {
            Title = "Delete Program",
            Description = $"Delete '{program.Name}'? This cannot be undone.",
            Icon = "close",
            Mode = PopupMode.Confirmation,
            CustomButtons = new List<PopupButton>
            {
                new() { Text = "Delete", ActionId = PopupResult.ConfirmedAction, Type = PopupButtonType.Destructive },
                new() { Text = "Cancel", ActionId = PopupResult.RejectedAction, Type = PopupButtonType.Ghost }
            }
        });

        if (result.IsConfirmed)
        {
            await ProgramService.DeleteProgramAsync(program.Id);
            await LoadData();
        }
    }


    public void Dispose()
    {
    }

}