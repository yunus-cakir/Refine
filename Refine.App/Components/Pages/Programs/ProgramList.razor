@page "/programs"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService ProgramService

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0">Programlar</h3>
    <a href="/programs/edit/0" class="btn btn-primary rounded-pill px-3 fw-bold">
        <i class="bi bi-plus-lg me-1"></i> Yeni
    </a>
</div>

@if (_programs == null)
{
    <div class="text-center mt-5"><div class="spinner-border text-primary"></div></div>
}
else if (_programs.Count == 0)
{
    <div class="text-center text-muted mt-5">
        <p>Henüz kayıtlı bir program yok.</p>
    </div>
}
else
{
    <div class="row g-3 pb-5">
        @foreach (var program in _programs)
        {
            <div class="col-12">
                <div class="refine-card position-relative overflow-hidden">

                    <button class="btn btn-dark btn-sm position-absolute top-0 end-0 m-2 text-danger border-0 bg-opacity-50"
                            style="z-index: 20; width: 36px; height: 36px; border-radius: 10px;"
                            @onclick="() => DeleteProgram(program)"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-trash-fill"></i>
                    </button>

                    <NavLink class="text-decoration-none text-white d-block p-3" href="@($"/programs/{program.Id}")">

                        <div class="pe-5">
                            <h5 class="fw-bold mb-2">@program.Name</h5>

                            <div class="d-flex align-items-center gap-2">
                                <span class="badge badge-pill">
                                    @program.Level
                                </span>
                            </div>
                        </div>

                        <div class="mt-3 text-muted small">
                            <i class="bi bi-trophy-fill me-1 text-secondary"></i> @program.Goal
                        </div>

                    </NavLink>

                </div>
            </div>
        }
    </div>
}

@code {
    private List<WorkoutProgram>? _programs;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _programs = await ProgramService.GetAllProgramsAsync();
    }

    private async Task DeleteProgram(WorkoutProgram program)
    {
        bool confirm = await UiHelper.ShowConfirm("Programı Sil",
            $"'{program.Name}' programını silmek istediğine emin misin?",
            "Evet, Sil", "Vazgeç");

        if (confirm)
        {
            await ProgramService.DeleteProgramAsync(program.Id);
            await LoadData();
        }
    }
}