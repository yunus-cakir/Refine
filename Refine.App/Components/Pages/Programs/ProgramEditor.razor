@page "/programs/edit/{Id:int}"
@using Refine.App.Models
@using Refine.App.Services

@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject TopBarBridge TopBar
@implements IDisposable

@if (_showTopBarMenu)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
    <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
        <button type="button" class="refine-dropdown-item" @onclick="async () => { ToggleTopBarMenu(); await SaveProgram(); }">
            <span class="material-symbols-outlined text-[20px]">check</span>
            Save Program
        </button>
    </div>
}

<div class="page-container py-4 px-0 min-h-screen">
    @if (_isLoading)
    {
        <RfSpinner IsLoading="true"/>
    }
    else
    {
        <EditForm Model="@_program" OnValidSubmit="SaveProgram">
            <DataAnnotationsValidator />

            <RfInput Title="Program Name" Icon="fitness_center" Placeholder="e.g. 5x5 Power" @bind-Value="_program.Name"/>

            <div class="row g-2 mb-4 animate-fade-in" style="animation-delay: 0.05s;">
                <div class="col-6">
                    <div class="text-on-surface-variant small mb-2 text-uppercase fw-bold" style="letter-spacing: 0.15em; font-size: 11px;">Level</div>
                    <select @bind="_program.Level" class="form-select w-100 text-white" style="border-radius: 12px; background-color: var(--refine-surface) !important; border: 1px solid rgba(255,255,255,0.05) !important; padding: 12px 16px; height: 50px;">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                </div>
                <div class="col-6">
                    <div class="text-on-surface-variant small mb-2 text-uppercase fw-bold" style="letter-spacing: 0.15em; font-size: 11px;">Goal</div>
                    <select @bind="_program.Goal" class="form-select w-100 text-white" style="border-radius: 12px; background-color: var(--refine-surface) !important; border: 1px solid rgba(255,255,255,0.05) !important; padding: 12px 16px; height: 50px;">
                        <option value="Muscle Gain">Muscle Gain</option>
                        <option value="Strength">Strength</option>
                        <option value="Fat Loss">Fat Loss</option>
                        <option value="Endurance">Endurance</option>
                    </select>
                </div>
            </div>

            <RfInput Title="Environment" Icon="location_on" Placeholder="e.g. Gym, Home" Delay="0.1" @bind-Value="_program.Environment"/>

            <div class="mt-4 px-1 pb-4 animate-fade-in" style="animation-delay: 0.15s;">
                <button type="submit" class="rf-button-primary w-100">
                    <span class="material-symbols-outlined" style="font-size: 20px;">@(Id == 0 ? "add" : "check")</span>
                    @(Id == 0 ? "CREATE PROGRAM" : "SAVE PROGRAM")
                </button>
            </div>
        </EditForm>

        @if (Id != 0)
        {
            <div class="mt-2 animate-fade-in" style="animation-delay: 0.2s;">
                <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                    <div class="text-on-surface-variant small text-uppercase fw-bold m-0" style="letter-spacing: 0.15em; font-size: 11px;">Workouts</div>
                    <a href="@($"/workouts/edit/{Id}/0")" class="rf-button-primary text-decoration-none d-flex align-items-center" style="font-size: 12px; padding: 6px 12px; border-radius: 20px;">
                        <span class="material-symbols-outlined me-1" style="font-size: 16px;">add</span> Add New
                    </a>
                </div>

                <div class="rf-card p-3 mb-4 d-flex flex-column gap-2" style="background: transparent; border: 1px dashed rgba(255,255,255,0.2) !important;">
                    <label class="text-on-surface-variant small mb-1 fw-bold" style="font-size: 11px;">Copy from Standalone Workouts:</label>
                    <div class="d-flex gap-2">
                        <select class="form-select flex-grow-1 text-white" @bind="_selectedStandaloneId" style="border-radius: 12px; background-color: var(--refine-surface) !important; border: 1px solid rgba(255,255,255,0.05) !important;">
                            <option value="0">Select workout...</option>
                            @if (_standaloneWorkouts != null)
                            {
                                @foreach (var w in _standaloneWorkouts)
                                {
                                    <option value="@w.Id">@w.Name (@(w.Items?.Count ?? 0) Exercises)</option>
                                }
                            }
                        </select>
                        <button type="button" class="rf-button-primary px-3 fw-bold d-flex align-items-center justify-content-center" @onclick="ImportWorkout" style="border-radius: 12px; height: 50px;">
                            <span class="material-symbols-outlined" style="font-size: 18px;">content_copy</span>
                        </button>
                    </div>
                </div>

                <div id="workout-list" class="d-flex flex-column gap-3 pb-5">
                    @if (_program.Workouts != null && _program.Workouts.Any())
                    {
                        @foreach (var workout in _program.Workouts.OrderBy(w => w.Order))
                        {
                            <div class="rf-card d-flex justify-content-between align-items-center exercise-card" style="padding: 12px 16px;" @key="workout.Id">
                                <div class="d-flex align-items-center">
                                    <div class="drag-handle me-3" style="cursor: move; padding: 10px; color: rgba(255,255,255,0.2);">
                                        <span class="material-symbols-outlined fs-4">drag_indicator</span>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-white fs-5">@workout.Name</span>
                                        <span class="text-on-surface-variant lh-1" style="font-size: 14px; margin-top: 1px;">@(workout.Items?.Count ?? 0) Exercises</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="@($"/workouts/edit/{Id}/{workout.Id}")" class="btn btn-sm text-white icon-btn">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">edit</span>
                                    </a>
                                    <button type="button" class="btn btn-sm border-0 icon-btn" @onclick="() => DeleteWorkout(workout)">
                                        <span class="material-symbols-outlined" style="font-size: 18px; color: #ff4d4d;">close</span>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 rounded mb-4" style="border: 1px dashed rgba(255,255,255,0.2); color: rgba(255,255,255,0.4);">
                            No workouts added yet.
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private WorkoutProgram _program = new();
    private List<Workout>? _standaloneWorkouts;
    private int _selectedStandaloneId;
    private bool _showTopBarMenu = false;
    private bool _isLoading = true;

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            TopBar.SetDetailMode(Id == 0 ? "New Program" : "Edit Program");
            _standaloneWorkouts = await DbService.GetStandaloneWorkoutsAsync();

            if (Id != 0)
            {
                await LoadProgramData();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadProgramData()
    {
        var existing = await DbService.GetProgramByIdAsync(Id);
        if (existing != null)
            _program = existing;
    }

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
        _objRef?.Dispose();
    }

    private async Task SaveProgram()
    {
        int newId = await DbService.SaveWorkoutProgramAsync(_program);

        if (Id == 0)
        {
            Id = newId;
            NavManager.NavigateTo($"/programs/edit/{newId}", replace: true);
            TopBar.SetDetailMode("Edit Program");
            await LoadProgramData();
        }
        else
        {
            await UiHelper.ShowAlert("Success", "Program updated successfully.", "OK");
        }
    }

    private async Task ImportWorkout()
    {
        if (_selectedStandaloneId == 0) return;

        await DbService.DuplicateWorkoutToProgramAsync(_selectedStandaloneId, Id);
        await LoadProgramData();
        _selectedStandaloneId = 0; 
    }

    private async Task DeleteWorkout(Workout w)
    {
        bool confirm = await UiHelper.ShowConfirm("Delete",
            "Are you sure you want to delete this workout from the program?",
            "Yes", "No");

        if (confirm)
        {
            await DbService.DeleteWorkoutAsync(w.Id);
            await LoadProgramData();
        }
    }

    private DotNetObjectReference<ProgramEditor>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Id != 0) 
        {
            _objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initSortable", "workout-list", _objRef);
        }
    }

    [JSInvokable]
    public async Task OnUpdateOrder(int oldIndex, int newIndex) 
    {
        var sortedList = _program.Workouts.OrderBy(w => w.Order).ToList();
        var itemToMove = sortedList[oldIndex];

        sortedList.RemoveAt(oldIndex);
        sortedList.Insert(newIndex, itemToMove);

        for (int i = 0; i < sortedList.Count; i++)
        {
            sortedList[i].Order = i + 1;
        }

        _program.Workouts = sortedList;
        StateHasChanged(); 

        await DbService.UpdateWorkoutOrdersAsync(sortedList);
    }
}