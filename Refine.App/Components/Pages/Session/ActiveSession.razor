@page "/session/active/{WorkoutId:int}"
@page "/session/edit/{WorkoutId:int}/{DateTicks:long}"
@layout Refine.App.Components.UI.Layout.FullScreenLayout

@using Refine.App.Models
@using Refine.App.Services
@using Refine.App.Helpers
@using Microsoft.AspNetCore.Components.Routing
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@inject TopBarBridge TopBar
@inject NavigationBridge NavBridge
@inject HomeStateService StateService
@implements IDisposable

<NavigationLock OnBeforeInternalNavigation="HandleInternalNavigation" ConfirmExternalNavigation="false"/>


<style>
    /* Hide scrollbar for clean reel feel */
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Ensure the main page is full screen */
    .active-session-page {
        height: 100dvh;
        width: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Force snapping to stop at each section */
    .snap-section {
        scroll-snap-stop: always;
    }
</style>

@if (_workout == null)
{
    <RfSpinner IsLoading="true" />
}
else
{
    <div class="active-session-page font-body animate-fade-in" style="background-color: var(--color-background); color: var(--color-on-surface); position: relative;">
        @if (_showTopBarMenu)
        {
            <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
            <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
                <button class="refine-dropdown-item-primary" style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);" @onclick="() => { ToggleTopBarMenu(); _ = FinishWorkout(); }">
                    <span class="material-symbols-outlined text-[20px]">task_alt</span>
                    @(DateTicks.HasValue ? "Update Session" : "Finish Workout")
                </button>
                <button class="refine-dropdown-item" style="border-bottom: none;" @onclick="() => { ToggleTopBarMenu(); CopyAllPreviousData(); }">
                    <span class="material-symbols-outlined text-[20px]">content_copy</span>
                    Copy All Previous Data
                </button>
            </div>
        }

        <!-- Main Reels -->
        <main id="active-session-reels" class="hide-scrollbar" style="flex: 1; overflow-y: auto; scroll-snap-type: y mandatory; position: relative; padding-bottom: env(safe-area-inset-bottom);">
            @for (int i = 0; i < _exercises.Count; i++)
            {
                var item = _exercises[i];
                var currentIndex = i; // local copy for closure
                var currentLogs = _activeLogs.Where(l => l.ExerciseId == item.ExerciseId).OrderBy(l => l.SetNumber).ToList();

                <section id="exercise-@currentIndex" class="snap-section" style="height: 100%; width: 100%; scroll-snap-align: start; position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 16px 16px 24px 16px; border-bottom: 1px solid rgba(255,255,255,0.05);">

                    <!-- Dynamic Background Placeholder -->
                    <div style="position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; background-image: @ExerciseImageResolver.GetBackgroundImageCss(item.Exercise);"></div>
                    <div style="position: absolute; inset: 0; z-index: 0; background: linear-gradient(to bottom, rgba(18,20,20,0.95), rgba(18,20,20,0.5), rgba(18,20,20,0.95));"></div>

                    <!-- Top Info Container -->
                    <div class="rf-flex-col" style="position: relative; z-index: 50; gap: 16px;">
                        <div class="rf-flex-row rf-justify-between" style="align-items: flex-start;">
                            <div style="flex: 1;">
                                <span class="refine-badge">
                                    @item.Sets Sets
                                </span>
                                <h1 class="font-headline" style="font-size: 30px; font-weight: bold; color: white; margin-top: 12px; letter-spacing: -0.025em; filter: drop-shadow(0 4px 3px rgba(0,0,0,0.07));">
                                    @ExerciseFormatter.Format(item.Exercise)
                                </h1>
                                <p class="font-body rf-flex-row rf-items-center" style="font-size: 14px; color: var(--color-on-surface-variant); gap: 8px; margin-top: 8px;">
                                    <span class="material-symbols-outlined" style="font-size: 14px;">fitness_center</span>
                                    @item.Exercise.PrimaryMuscleCategory
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Sets Panel (Horizontal Swipeable View) -->
                    <div id="sets-container-@item.ExerciseId" class="hide-scrollbar" style="display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 16px; margin-bottom: 8px; padding-bottom: 8px; width: calc(100% + 32px); margin-left: -16px; padding-left: 16px; padding-right: 16px; box-sizing: border-box; scroll-behavior: smooth; position: relative; z-index: 50;">
                        @for (int s = 1; s <= item.Sets; s++)
                        {
                            var sClosure = s;
                            var activeLog = currentLogs.FirstOrDefault(l => l.SetNumber == sClosure);
                            if (activeLog == null)
                            {
                                activeLog = new WorkoutLog { ExerciseId = item.ExerciseId, ExerciseNameSnapshot = ExerciseFormatter.Format(item.Exercise), WorkoutId = WorkoutId, SetNumber = sClosure, Date = _targetDate, FormRating = 3, IsCompleted = false, IsSaved = false, Week = Week ?? _currentProgramWeek };
                                
                                var historyForSet = GetHistoryLog(item.ExerciseId, sClosure);
                                if (historyForSet != null && _currentUser?.WorkoutSettings != null)
                                {
                                    activeLog.SetAutoCopiedValues(
                                        _currentUser.WorkoutSettings.AutoCopyWeight ? historyForSet.Weight : null,
                                        _currentUser.WorkoutSettings.AutoCopyReps ? historyForSet.Reps : null,
                                        _currentUser.WorkoutSettings.AutoCopyRIR ? historyForSet.RIR : null,
                                        _currentUser.WorkoutSettings.AutoCopyFormRating ? historyForSet.FormRating : 3
                                    );
                                }

                                _activeLogs.Add(activeLog);
                                currentLogs.Add(activeLog);
                            }

                            var history = GetHistoryLog(item.ExerciseId, sClosure);

                            // Temporary debug logging
                            Console.WriteLine($"[Debug] ExId: {item.ExerciseId}, PrevWorkoutId: {history?.WorkoutId}, RetrievedSetCount: {(_historyData.ContainsKey(item.ExerciseId) ? _historyData[item.ExerciseId].Count : 0)}, SetNumber: {sClosure}, Weight: {history?.Weight}, Reps: {history?.Reps}, GhostTextWeight: {history?.Weight?.ToString() ?? "-"}, GhostTextReps: {history?.Reps?.ToString() ?? "-"}");

                            <div id="set-card-@(item.ExerciseId)-@sClosure" class="refine-active-card" style="min-width: 100%; scroll-snap-align: center; scroll-snap-stop: always; flex-shrink: 0; margin-bottom: 0;">

                                <!-- Inputs Grid -->
                                <div style="display: grid; grid-template-columns: repeat(@(item.Exercise.Equipment == Exercise.EquipmentType.Bodyweight ? 2 : 3), 1fr); gap: 12px; margin-bottom: 8px;">
                                    @if (item.Exercise.Equipment != Exercise.EquipmentType.Bodyweight)
                                    {
                                        <!-- Weight -->
                                        <div class="rf-flex-col rf-items-center">
                                            <span class="refine-input-label">Weight</span>
                                            <input type="number" inputmode="decimal"
                                                   class="rf-input-number"
                                                   placeholder="@(history?.Weight.ToString() ?? "-")"
                                                   @bind="activeLog.UIWeight"/>
                                        </div>
                                    }
                                    <!-- Reps -->
                                    <div class="rf-flex-col rf-items-center">
                                        <span class="refine-input-label">Reps</span>
                                        <input type="number" inputmode="numeric"
                                               class="rf-input-number"
                                               placeholder="@(history?.Reps.ToString() ?? "-")"
                                               @bind="activeLog.UIReps"/>
                                    </div>
                                    <!-- RIR -->
                                    <div class="rf-flex-col rf-items-center">
                                        <span class="refine-input-label">RIR</span>
                                        <input type="number" inputmode="numeric"
                                               class="rf-input-number"
                                               placeholder="@(history?.RIR.ToString() ?? "-")"
                                               @bind="activeLog.UIRIR"/>
                                    </div>
                                </div>

                                <!-- Form Rating -->
                                <div class="rf-flex-row rf-justify-center rf-items-center" style="gap: 16px; margin-bottom: 8px;">
                                    <button style="padding: 0; background: transparent; border: none; cursor: pointer; transition: transform 0.2s ease; color: @(activeLog.UIFormRating == 1 ? "#ffc107" : "rgba(255,255,255,0.2)"); filter: @(activeLog.UIFormRating == 1 ? "drop-shadow(0 0 12px rgba(255,193,7,0.6))" : "none"); transform: @(activeLog.UIFormRating == 1 ? "scale(1.1)" : "scale(1)");"
                                            @onclick="() => activeLog.UIFormRating = 1">
                                        <span class="material-symbols-outlined" style="font-size: 28px; font-variation-settings: 'FILL' @(activeLog.UIFormRating == 1 ? "1" : "0");">sentiment_neutral</span>
                                    </button>
                                    <button style="padding: 0; background: transparent; border: none; cursor: pointer; transition: transform 0.2s ease; color: @(activeLog.UIFormRating == 2 ? "#198754" : "rgba(255,255,255,0.2)"); filter: @(activeLog.UIFormRating == 2 ? "drop-shadow(0 0 12px rgba(25,135,84,0.6))" : "none"); transform: @(activeLog.UIFormRating == 2 ? "scale(1.1)" : "scale(1)");"
                                            @onclick="() => activeLog.UIFormRating = 2">
                                        <span class="material-symbols-outlined" style="font-size: 28px; font-variation-settings: 'FILL' @(activeLog.UIFormRating == 2 ? "1" : "0");">sentiment_satisfied</span>
                                    </button>
                                    <button style="padding: 0; background: transparent; border: none; cursor: pointer; transition: transform 0.2s ease; color: @(activeLog.UIFormRating == 3 ? "#f97316" : "rgba(255,255,255,0.2)"); filter: @(activeLog.UIFormRating == 3 ? "drop-shadow(0 0 12px rgba(249,115,22,0.6))" : "none"); transform: @(activeLog.UIFormRating == 3 ? "scale(1.1)" : "scale(1)");"
                                            @onclick="() => activeLog.UIFormRating = 3">
                                        <span class="material-symbols-outlined" style="font-size: 28px; font-variation-settings: 'FILL' @(activeLog.UIFormRating == 3 ? "1" : "0");">local_fire_department</span>
                                    </button>
                                </div>

                                <!-- Log Button -->
                                <button class="rf-button-primary"
                                        @onclick="() => LogSet(item.ExerciseId, currentIndex, item.Sets, _exercises.Count, sClosure)">
                                    <span class="material-symbols-outlined" style='font-size: 20px; font-variation-settings: "wght" 700;'>done_all</span>
                                    LOG SET @sClosure
                                </button>

                                <!-- Bottom Links -->
                                <div class="rf-flex-row rf-justify-center" style="gap: 24px; margin-top: 8px; opacity: 0.7; transform: scale(0.9); transform-origin: top;">
                                    <button class="refine-ghost-btn" @onclick="() => OpenHistory(item.ExerciseId, ExerciseFormatter.Format(item.Exercise))">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">history</span> HISTORY
                                    </button>
                                    <button class="refine-ghost-btn">
                                        <span class="material-symbols-outlined" style="font-size: 18px;">videocam</span> FORM VIDEO
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Scroll Hint (Only if not the last exercise) -->
                    @if (currentIndex != _exercises.Count - 1)
                    {
                        <div class="rf-flex-row rf-justify-center" style="position: absolute; bottom: 24px; left: 0; right: 0; z-index: 10; opacity: 0.5; pointer-events: none; animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;">
                            <span class="material-symbols-outlined" style="color: white; font-size: 30px;">keyboard_arrow_down</span>
                        </div>
                    }
                </section>
            }

            <!-- Final Summary / Finish Slide -->
            <section id="finish-slide" class="snap-section" style="height: 100%; width: 100%; scroll-snap-align: start; position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: var(--color-background); padding: 0 32px; text-align: center; border-top: 1px solid rgba(255,255,255,0.05);">
                <span class="material-symbols-outlined" style="font-size: 60px; color: var(--color-primary-container); margin-bottom: 16px; filter: drop-shadow(0 0 20px rgba(195,244,0,0.5));">task_alt</span>
                <h2 class="font-headline" style="font-size: 30px; font-weight: bold; color: white; margin-bottom: 8px;">Great Job!</h2>
                <p class="font-body" style="color: var(--color-on-surface-variant); margin-bottom: 32px; max-width: 320px;">You've reached the end of your session. Review your sets and complete the workout.</p>
                <button class="rf-button-secondary"
                        @onclick="FinishWorkout">
                    <span class="material-symbols-outlined" style='font-size: 20px; font-variation-settings: "wght" 700;'>done_all</span>
                    @(DateTicks.HasValue ? "UPDATE SESSION" : "FINISH WORKOUT")
                </button>
            </section>
        </main>
    </div>
}

@if (_showToast)
{
    <div class="toast-container">
        <div class="refine-toast" style="display: flex; align-items: center; gap: 8px; white-space: nowrap;">
            <i class="bi bi-info-circle-fill" style="color: var(--color-primary-container);"></i>
            <span class="font-body" style="font-size: 14px; font-weight: 500; color: white;">You have been redirected to your current workout.</span>
        </div>
    </div>
}

@if (_showExitModal)
{
    <div class="exit-modal-overlay">
        <div class="exit-modal-container animate-fade-in">
            <div class="exit-modal-icon-box">
                <span class="material-symbols-outlined" style="font-size: 36px; color: #ffb4ab;">warning</span>
            </div>

            <h3 class="font-headline exit-modal-title">Exit Workout?</h3>

            <div class="rf-flex-col" style="gap: 12px;">
                <!-- Return to Workout (Primary) -->
                <button class="exit-modal-btn exit-modal-btn-primary" @onclick="CancelExit">
                    <span class="material-symbols-outlined">fitness_center</span>
                    <span>RETURN TO WORKOUT</span>
                </button>

                <!-- Save & Quit (Inverse) -->
                <button class="exit-modal-btn exit-modal-btn-inverse" @onclick="SaveAndExitAsync">
                    <span class="material-symbols-outlined">check</span>
                    <span>SAVE & QUIT</span>
                </button>

                <!-- Discard & Quit (Red Ghost) -->
                <button class="exit-modal-btn exit-modal-btn-ghost" @onclick="DiscardAndExitAsync">
                    <span class="material-symbols-outlined">delete_forever</span>
                    <span>DISCARD & QUIT</span>
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int WorkoutId { get; set; }

    // Düzenleme modu için tarih parametresi
    [Parameter] public long? DateTicks { get; set; }

    // Resume modu için query parametresi
    [SupplyParameterFromQuery(Name = "resuming")]
    public bool IsResuming { get; set; }

    [SupplyParameterFromQuery] public int? Week { get; set; }
    [SupplyParameterFromQuery] public int? Cycle { get; set; }

    private User? _currentUser;
    private Workout? _workout;
    private int _currentProgramWeek = 1;
    private int _currentProgramCycle = 1;
    private List<WorkoutItem> _exercises = new();
    private List<WorkoutLog> _activeLogs = new();
    private Dictionary<int, List<WorkoutLog>> _historyData = new();

    private bool _showToast = false;
    private int? _openMenuId = null;
    private Dictionary<int, int> _currentSetIndex = new();
    private bool _showTopBarMenu = false;

    private bool _showExitModal = false;
    private bool _allowNavigation = false;
    private string? _pendingTargetLocation;
    private bool _hasScrolledToLastPerformed = false;

    // İşlem yapılacak hedef tarih (Edit ise geçmiş tarih, Yeni ise şimdiki zaman)
    private DateTime _targetDate;

    protected override void OnInitialized()
    {
        TopBar.OnLeftActionTapped += HandleLeftAction;
        TopBar.OnRightActionTapped += HandleRightAction;
        NavBridge.OnHardwareBackRequested += HandleHardwareBack;
    }

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await DbService.GetUserAsync();
        _workout = await DbService.GetWorkoutByIdAsync(WorkoutId);

        if (_workout != null && _workout.Items != null)
        {
            var program = await DbService.GetProgramByIdAsync(_workout.WorkoutProgramId);
            if (program != null)
            {
                _currentProgramWeek = program.Week;
                _currentProgramCycle = program.Cycle;

                if (Week.HasValue && Week.Value > program.Week)
                {
                    program.Week = Week.Value;
                    await DbService.SaveWorkoutProgramAsync(program);
                    _currentProgramWeek = program.Week;
                }
            }

            _exercises = _workout.Items.OrderBy(i => i.Order).ToList();
            TopBar.SetDetailMode(_workout.Name);
            // 1. Hedef Tarihi Belirle
            if (DateTicks.HasValue)
            {
                // Edit Mode: Parametreden gelen tarih
                _targetDate = new DateTime(DateTicks.Value);
            }
            else
            {
                // Active Mode: Şu an
                _targetDate = DateTime.Now;
            }

            // 2. Geçmiş Verileri (Ghost Text ve Auto Copy için) Hazırla
            foreach (var item in _exercises)
            {
                var history = await DbService.GetLastLogForExerciseAsync(item.ExerciseId);
                if (history.Any())
                {
                    _historyData[item.ExerciseId] = history;
                }
            }

            // 3. Logları Yükle veya Oluştur
            if (DateTicks.HasValue)
            {
                // --- EDIT MODE ---
                // O tarihteki logları çek
                var logs = await DbService.GetSessionLogsAsync(WorkoutId, _targetDate);
                _activeLogs = logs.OrderBy(l => l.SetNumber).ToList();
            }
            else
            {
                // --- ACTIVE MODE ---
                // Bugün için kayıt var mı kontrol et (Resume)
                var existingLogs = await DbService.GetSessionLogsAsync(WorkoutId, DateTime.Now);

                if (existingLogs.Any())
                {
                    _activeLogs = existingLogs.OrderBy(l => l.SetNumber).ToList();

                    int activeWeek = Week ?? _currentProgramWeek;
                    int activeCycle = Cycle ?? _currentProgramCycle;
                    foreach (var log in _activeLogs)
                    {
                        if (log.Week <= 0 || log.Week != activeWeek)
                        {
                            log.Week = activeWeek;
                        }
                        if (log.Cycle <= 0 || log.Cycle != activeCycle)
                        {
                            log.Cycle = activeCycle;
                        }
                    }

                    if (IsResuming)
                    {
                        _showToast = true;
                        _ = RemoveToastAfterDelay();
                    }
                }
                else
                {
                    // Yoksa sıfırdan oluştur
                    foreach (var item in _exercises)
                    {
                        for (int i = 1; i <= item.Sets; i++)
                        {
                            var newLog = new WorkoutLog
                            {
                                ExerciseId = item.ExerciseId,
                                ExerciseNameSnapshot = ExerciseFormatter.Format(item.Exercise),
                                WorkoutId = WorkoutId,
                                SetNumber = i,
                                Date = _targetDate, // Sabitlenen tarihi kullan
                                FormRating = 3,
                                IsCompleted = false,
                                IsSaved = false,
                                Week = Week ?? _currentProgramWeek,
                                Cycle = Cycle ?? _currentProgramCycle
                            };

                            _activeLogs.Add(newLog);
                        }
                    }
                }
            }

            // Initialize UI values
            foreach (var log in _activeLogs)
            {
                log.UIWeight = log.Weight;
                log.UIReps = log.Reps;
                log.UIRIR = log.RIR;
                log.UIFormRating = log.FormRating > 0 ? log.FormRating : 3;
                log.IsUiModified = false;

                // For newly created or unlogged sets, auto copy if enabled
                if (!DateTicks.HasValue && log.Weight == null && log.Reps == null)
                {
                    var historyForSet = GetHistoryLog(log.ExerciseId, log.SetNumber);
                    if (historyForSet != null && _currentUser?.WorkoutSettings != null)
                    {
                        log.SetAutoCopiedValues(
                            _currentUser.WorkoutSettings.AutoCopyWeight ? historyForSet.Weight : null,
                            _currentUser.WorkoutSettings.AutoCopyReps ? historyForSet.Reps : null,
                            _currentUser.WorkoutSettings.AutoCopyRIR ? historyForSet.RIR : null,
                            _currentUser.WorkoutSettings.AutoCopyFormRating ? historyForSet.FormRating : 3
                        );
                    }
                }
            }

            // Init current sets
            foreach (var item in _exercises)
            {
                var logsForExercise = _activeLogs.Where(l => l.ExerciseId == item.ExerciseId).OrderBy(l => l.SetNumber).ToList();
                var firstUncompletedLog = logsForExercise.FirstOrDefault(l => (item.Exercise.Equipment != Exercise.EquipmentType.Bodyweight && !l.Weight.HasValue) || !l.Reps.HasValue);
                if (firstUncompletedLog != null)
                {
                    _currentSetIndex[item.ExerciseId] = firstUncompletedLog.SetNumber;
                }
                else
                {
                    _currentSetIndex[item.ExerciseId] = item.Sets;
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_workout != null && !_hasScrolledToLastPerformed)
        {
            _hasScrolledToLastPerformed = true;
            await ScrollToLastPerformedExerciseAsync();
            await InitScrollTrackingAsync();
        }
    }

    private async Task ScrollToLastPerformedExerciseAsync()
    {
        if (_exercises == null || !_exercises.Any()) return;

        // Try to get from localStorage first
        string? savedSlideId = null;
        try
        {
            savedSlideId = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", $"active_session_slide_{WorkoutId}");
        }
        catch
        {
            // Ignore storage errors
        }

        if (!string.IsNullOrEmpty(savedSlideId))
        {
            await JSRuntime.InvokeVoidAsync("eval", $"var el = document.getElementById('{savedSlideId}'); if (el) el.scrollIntoView({{ behavior: 'auto' }});");
            return;
        }

        // Fallback: Check if all exercises are completely performed
        bool allExercisesCompleted = true;
        int lastPerformedIndex = -1;

        for (int i = 0; i < _exercises.Count; i++)
        {
            var item = _exercises[i];
            var logsForExercise = _activeLogs.Where(l => l.ExerciseId == item.ExerciseId).ToList();
            bool hasAnyCompletedSet = logsForExercise.Any(l => (item.Exercise.Equipment == Exercise.EquipmentType.Bodyweight || l.Weight.HasValue) && l.Reps.HasValue);
            bool isFullyCompleted = logsForExercise.Count >= item.Sets && logsForExercise.All(l => (item.Exercise.Equipment == Exercise.EquipmentType.Bodyweight || l.Weight.HasValue) && l.Reps.HasValue);

            if (hasAnyCompletedSet)
            {
                lastPerformedIndex = i;
            }

            if (!isFullyCompleted)
            {
                allExercisesCompleted = false;
            }
        }

        if (allExercisesCompleted)
        {
            await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('finish-slide'); if (el) el.scrollIntoView({ behavior: 'auto' });");
        }
        else if (lastPerformedIndex != -1)
        {
            int scrollIndex = lastPerformedIndex;
            var lastPerformedExercise = _exercises[lastPerformedIndex];
            var logsForLast = _activeLogs.Where(l => l.ExerciseId == lastPerformedExercise.ExerciseId).ToList();
            bool isLastFullyCompleted = logsForLast.Count >= lastPerformedExercise.Sets && logsForLast.All(l => (lastPerformedExercise.Exercise.Equipment == Exercise.EquipmentType.Bodyweight || l.Weight.HasValue) && l.Reps.HasValue);

            if (isLastFullyCompleted && lastPerformedIndex < _exercises.Count - 1)
            {
                scrollIndex = lastPerformedIndex + 1;
            }

            await JSRuntime.InvokeVoidAsync("eval", $"var el = document.getElementById('exercise-{scrollIndex}'); if (el) el.scrollIntoView({{ behavior: 'auto' }});");
            
            // Also scroll horizontally to the first uncompleted set of that exercise
            var exerciseToScroll = _exercises[scrollIndex];
            if (_currentSetIndex.TryGetValue(exerciseToScroll.ExerciseId, out var uncompletedSet) && uncompletedSet > 1)
            {
                await JSRuntime.InvokeVoidAsync("eval", $"setTimeout(function() {{ var nextCard = document.getElementById('set-card-{exerciseToScroll.ExerciseId}-{uncompletedSet}'); if (nextCard) {{ nextCard.scrollIntoView({{ behavior: 'auto', block: 'nearest', inline: 'center' }}); }} }}, 50);");
            }
        }
    }

    private async Task InitScrollTrackingAsync()
    {
        var script = @"
            window.initActiveSessionScrollTracking = window.initActiveSessionScrollTracking || function(mainId, workoutId) {
                var mainEl = document.getElementById(mainId);
                if (!mainEl) return;
                
                if (mainEl._observer) {
                    mainEl._observer.disconnect();
                }
                
                if (!window.IntersectionObserver) return;
                
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            var id = entry.target.id;
                            if (id) {
                                localStorage.setItem('active_session_slide_' + workoutId, id);
                            }
                        }
                    });
                }, {
                    root: mainEl,
                    threshold: 0.5
                });
                
                var sections = mainEl.querySelectorAll('.snap-section');
                sections.forEach(function(section) {
                    observer.observe(section);
                });
                
                mainEl._observer = observer;
            };
            window.initActiveSessionScrollTracking('active-session-reels', " + WorkoutId + ");";

        await JSRuntime.InvokeVoidAsync("eval", script);
    }



    private async Task LogSet(int exerciseId, int currentExerciseIndex, int maxSets, int totalExercises, int loggedSetNumber)
    {
        var targetExercise = _exercises.FirstOrDefault(e => e.ExerciseId == exerciseId)?.Exercise;
        bool isBodyweight = targetExercise?.Equipment == Exercise.EquipmentType.Bodyweight;

        var activeLog = _activeLogs.FirstOrDefault(l => l.ExerciseId == exerciseId && l.SetNumber == loggedSetNumber);
        if (activeLog == null || (!isBodyweight && !activeLog.UIWeight.HasValue) || !activeLog.UIReps.HasValue)
        {
            string missingMsg = isBodyweight ? "Please enter a repetition value before logging this set." : "Please enter both weight and repetition values before logging this set.";
            await UiHelper.ShowAlert("Missing Info", missingMsg, "OK");
            return;
        }

        activeLog.Weight = activeLog.UIWeight;
        activeLog.Reps = activeLog.UIReps;
        activeLog.RIR = activeLog.UIRIR;
        activeLog.FormRating = activeLog.UIFormRating;

        // Save current progress as draft to database but do not change the IsCompleted and IsSaved values
        await DbService.UpdateSessionLogsAsync(_activeLogs);

        if (loggedSetNumber >= maxSets)
        {
            // We reached the max sets for this exercise.
            bool isLastExercise = (currentExerciseIndex == totalExercises - 1);

            if (isLastExercise)
            {
                // Scroll to Finish slide
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('finish-slide').scrollIntoView({ behavior: 'smooth' });");
            }
            else
            {
                // Scroll to Next exercise
                await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('exercise-{currentExerciseIndex + 1}').scrollIntoView({{ behavior: 'smooth' }});");
            }
        }
        else
        {
            int nextSet = loggedSetNumber + 1;
            // Move to next set horizontally
            await JSRuntime.InvokeVoidAsync("eval", $"var nextCard = document.getElementById('set-card-{exerciseId}-{nextSet}'); if (nextCard) {{ nextCard.scrollIntoView({{ behavior: 'smooth', block: 'nearest', inline: 'center' }}); }}");

            // Just in case the user went above planned sets (e.g. they added more)
            var exists = _activeLogs.Any(l => l.ExerciseId == exerciseId && l.SetNumber == nextSet);
            if (!exists)
            {
                var exercise = _exercises.FirstOrDefault(e => e.ExerciseId == exerciseId);
                var newExtraLog = new WorkoutLog
                {
                    ExerciseId = exerciseId,
                    ExerciseNameSnapshot = ExerciseFormatter.Format(exercise?.Exercise),
                    WorkoutId = WorkoutId,
                    SetNumber = nextSet,
                    Date = _targetDate,
                    FormRating = 3,
                    IsCompleted = false,
                    IsSaved = false,
                    Week = Week ?? _currentProgramWeek
                };

                var extraHistory = GetHistoryLog(exerciseId, nextSet);
                if (extraHistory != null && _currentUser?.WorkoutSettings != null)
                {
                    newExtraLog.SetAutoCopiedValues(
                        _currentUser.WorkoutSettings.AutoCopyWeight ? extraHistory.Weight : null,
                        _currentUser.WorkoutSettings.AutoCopyReps ? extraHistory.Reps : null,
                        _currentUser.WorkoutSettings.AutoCopyRIR ? extraHistory.RIR : null,
                        _currentUser.WorkoutSettings.AutoCopyFormRating ? extraHistory.FormRating : 3
                    );
                }

                _activeLogs.Add(newExtraLog);
            }
        }
    }

    private WorkoutLog? GetHistoryLog(int exerciseId, int setNumber)
    {
        if (_historyData.ContainsKey(exerciseId))
        {
            return _historyData[exerciseId].FirstOrDefault(l => l.SetNumber == setNumber);
        }

        return null;
    }

    private void CopyAllPreviousData()
    {
        if (_exercises == null || !_exercises.Any()) return;

        foreach (var item in _exercises)
        {
            if (!_historyData.ContainsKey(item.ExerciseId)) continue;

            var historyLogs = _historyData[item.ExerciseId];
            var currentExerciseLogs = _activeLogs.Where(l => l.ExerciseId == item.ExerciseId).ToList();

            foreach (var current in currentExerciseLogs)
            {
                var match = historyLogs.FirstOrDefault(h => h.SetNumber == current.SetNumber);
                if (match != null)
                {
                    current.Weight = match.Weight;
                    current.Reps = match.Reps;
                    current.RIR = match.RIR;
                    current.FormRating = match.FormRating;
                }
            }
        }
    }

    private async Task FinishWorkout()
    {
        string title = DateTicks.HasValue ? "Güncelle" : "Bitir";
        string msg = DateTicks.HasValue ? "Değişiklikler kaydedilsin mi?" : "Antrenman kaydedilsin mi?";

        // AGENTS.md kuralına göre doğrudan UiHelper.ShowConfirm kullanuyoruz.
        bool confirm = await UiHelper.ShowConfirm(title, msg, "Evet", "Hayır");

        if (confirm)
        {
            _allowNavigation = true;
            try
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"active_session_slide_{WorkoutId}");
            }
            catch
            {
            }

            foreach (var log in _activeLogs)
            {
                // Only save modified UI values if they weren't explicitly logged yet
                if (log.IsUiModified)
                {
                    log.Weight = log.UIWeight;
                    log.Reps = log.UIReps;
                    log.RIR = log.UIRIR;
                    log.FormRating = log.UIFormRating;
                }

                log.IsCompleted = true;
                log.IsSaved = true;
            }

            if (DateTicks.HasValue)
            {
                // Edit Mode: Update (Upsert) işlemi
                await DbService.UpdateSessionLogsAsync(_activeLogs);
                await StateService.LoadDataAsync(showSkeleton: false);
                NavManager.NavigateTo($"/history/detail/{WorkoutId}/{DateTicks}");
            }
            else
            {
                // Active Mode: Insert/Update işlemi
                await DbService.UpdateSessionLogsAsync(_activeLogs);
                await StateService.LoadDataAsync(showSkeleton: false);
                NavManager.NavigateTo("/");
            }
        }
    }

    private void HandleLeftAction()
    {
        _pendingTargetLocation = null; // history.back if exited
        _showExitModal = true;
        StateHasChanged();
    }

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    private async Task<bool> HandleHardwareBack()
    {
        if (!_showExitModal)
        {
            _showExitModal = true;
            _pendingTargetLocation = null; // history.back if exited
            await InvokeAsync(StateHasChanged);
            return true;
        }

        return true;
    }

    private async Task HandleInternalNavigation(LocationChangingContext context)
    {
        if (_allowNavigation)
        {
            return;
        }

        context.PreventNavigation();
        _pendingTargetLocation = context.TargetLocation;
        _showExitModal = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SaveAndExitAsync()
    {
        _showExitModal = false;
        _allowNavigation = true;

        foreach (var log in _activeLogs)
        {
            // Only save modified UI values if they weren't explicitly logged yet
            if (log.IsUiModified)
            {
                log.Weight = log.UIWeight;
                log.Reps = log.UIReps;
                log.RIR = log.UIRIR;
                log.FormRating = log.UIFormRating;
            }

            log.IsSaved = true;
            log.IsCompleted = false;
        }

        if (DateTicks.HasValue)
        {
            // Edit Mode: Update (Upsert) logs
            await DbService.UpdateSessionLogsAsync(_activeLogs);
            await StateService.LoadDataAsync(showSkeleton: false);

            if (!string.IsNullOrEmpty(_pendingTargetLocation))
            {
                NavManager.NavigateTo(_pendingTargetLocation);
            }
            else
            {
                NavManager.NavigateTo($"/history/detail/{WorkoutId}/{DateTicks}");
            }
        }
        else
        {
            // Active Mode: Save/Insert logs
            await DbService.SaveWorkoutLogsAsync(_activeLogs);
            await StateService.LoadDataAsync(showSkeleton: false);

            if (!string.IsNullOrEmpty(_pendingTargetLocation))
            {
                NavManager.NavigateTo(_pendingTargetLocation);
            }
            else
            {
                NavManager.NavigateTo("/");
            }
        }
    }

    private async Task DiscardAndExitAsync()
    {
        _showExitModal = false;
        _allowNavigation = true;

        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", $"active_session_slide_{WorkoutId}");
        }
        catch
        {
        }

        if (!string.IsNullOrEmpty(_pendingTargetLocation))
        {
            NavManager.NavigateTo(_pendingTargetLocation);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("history.back");
        }
    }

    private void CancelExit()
    {
        _showExitModal = false;
        _pendingTargetLocation = null;
    }

    private async Task RemoveToastAfterDelay()
    {
        await Task.Delay(3000);
        _showToast = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenHistory(int exerciseId, string exerciseName)
    {
        // Save current progress as draft so we don't lose entered values when we return
        await DbService.UpdateSessionLogsAsync(_activeLogs);

        _allowNavigation = true;
        NavManager.NavigateTo($"/analytics/detail/{exerciseId}?name={Uri.EscapeDataString(exerciseName)}");
    }

    public void Dispose()
    {
        TopBar.OnLeftActionTapped -= HandleLeftAction;
        TopBar.OnRightActionTapped -= HandleRightAction;
        NavBridge.OnHardwareBackRequested -= HandleHardwareBack;
    }

}