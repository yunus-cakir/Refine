@page "/exercises"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject SelectionStateService SelectionState
@inject IJSRuntime JS
@implements IDisposable

@if (_showTopBarMenu && !_isSelectionMode)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
    <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
        <button class="refine-dropdown-item" @onclick="AddExercise">
            <span class="material-symbols-outlined text-[20px]">add</span>
            Add New Exercise
        </button>
    </div>
}

@if (_exercises == null)
{
    <RfSpinner IsLoading="true" />
}
else
{
<div class="exercise-list-container py-3 px-0 animate-fade-in">
        <!-- Search bar -->
        <div class="mb-4">
            <div class="search-wrapper">
                <span class="material-symbols-outlined search-icon">search</span>
                <input type="text" 
                       class="search-input" 
                       placeholder="Search exercises..." 
                       @bind="_searchText" 
                       @bind:event="oninput" />
            </div>
        </div>

        @if (!FilteredExercises.Any())
        {
            <div class="text-center py-5 text-on-surface-variant font-body">
                <span class="material-symbols-outlined display-4 mb-3" style="opacity: 0.5;">fitness_center</span>
                <p>No exercises found.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 pb-5">
                @foreach (var ex in FilteredExercises)
                {
                    bool isSelected = _selectedExerciseIds.Contains(ex.Id);

                    <div class="rf-card exercise-card d-flex align-items-center justify-content-between p-3" 
                         @onclick="() => OnCardTapped(ex)">
                        
                        <div class="d-flex align-items-center gap-3">
                            <div class="exercise-icon-container">
                                <span class="material-symbols-outlined exercise-icon">fitness_center</span>
                            </div>
                            
                            <div class="d-flex flex-column align-items-start">
                                <span class="fw-bold text-white fs-6 mb-1 text-start">@ex.Name</span>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="rf-badge-faded" style="font-size: 10px; padding: 2px 8px;">
                                        @ex.PrimaryMuscleCategory
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(ex.Equipment))
                                    {
                                        <span class="text-on-surface-variant" style="font-size: 11px;">
                                            @ex.Equipment
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (_isSelectionMode)
                        {
                            <div class="ms-3" @onclick:stopPropagation="true">
                                <label class="custom-checkbox-container">
                                    <input type="checkbox" 
                                           checked="@isSelected" 
                                           @onchange="() => ToggleExerciseSelection(ex.Id)" />
                                    <span class="checkmark"></span>
                                </label>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_isSelectionMode)
        {
            <RfButton IsSticky="true" 
                      Icon="done" 
                      Text="@($"Add Selected ({_selectedExerciseIds.Count})")" 
                      OnClick="ConfirmSelection" />
        }
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "selection")]
    public bool Selection { get; set; }

    private List<Exercise>? _exercises;
    private string _searchText = "";
    private bool _showTopBarMenu = false;
    private bool _isSelectionMode = false;
    private HashSet<int> _selectedExerciseIds = new();

    private IEnumerable<Exercise> FilteredExercises
    {
        get
        {
            if (_exercises == null) return Enumerable.Empty<Exercise>();
            if (string.IsNullOrWhiteSpace(_searchText)) return _exercises;

            return _exercises.Where(e => 
                e.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                e.PrimaryMuscleCategory.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (e.Equipment != null && e.Equipment.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            );
        }
    }

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        _exercises = await DbService.GetExercisesAsync();
        if (_exercises != null)
        {
            _exercises = _exercises.OrderBy(e => e.Name).ToList();
        }
    }

    protected override void OnParametersSet()
    {
        _isSelectionMode = Selection;
        UpdateTopBarTitle();
    }

    private void UpdateTopBarTitle()
    {
        if (_isSelectionMode)
        {
            TopBar.SetDetailMode("Select Exercises");
        }
        else
        {
            TopBar.SetDetailMode("Exercises");
        }
    }

    private void HandleRightAction()
    {
        _showTopBarMenu = !_showTopBarMenu;
        StateHasChanged();
    }

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void EnableSelectionMode()
    {
        _showTopBarMenu = false;
        _isSelectionMode = true;
        _selectedExerciseIds.Clear();
        UpdateTopBarTitle();
    }

    private void DisableSelectionMode()
    {
        _showTopBarMenu = false;
        _isSelectionMode = false;
        _selectedExerciseIds.Clear();
        UpdateTopBarTitle();
    }

    private void AddExercise()
    {
        _showTopBarMenu = false;
        NavManager.NavigateTo("/exercises/edit/0");
    }

    private void OnCardTapped(Exercise ex)
    {
        if (_isSelectionMode)
        {
            ToggleExerciseSelection(ex.Id);
        }
        else
        {
            NavManager.NavigateTo($"/exercises/edit/{ex.Id}");
        }
    }

    private void ToggleExerciseSelection(int exerciseId)
    {
        if (_selectedExerciseIds.Contains(exerciseId))
        {
            _selectedExerciseIds.Remove(exerciseId);
        }
        else
        {
            _selectedExerciseIds.Add(exerciseId);
        }
        StateHasChanged();
    }

    private async Task ConfirmSelection()
    {
        _showTopBarMenu = false;
        if (!_selectedExerciseIds.Any())
        {
            await UiHelper.ShowAlert("No Selection", "Please select at least one exercise.", "OK");
            return;
        }

        if (!string.IsNullOrEmpty(SelectionState.ReturnUrl))
        {
            SelectionState.SelectedIds = _selectedExerciseIds.ToList();
            SelectionState.IsActive = true;
            await JS.InvokeVoidAsync("history.back");
            return;
        }

        string msg = $"Selected {_selectedExerciseIds.Count} exercises.";
        await UiHelper.ShowAlert("Success", msg, "OK");
        
        DisableSelectionMode();
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
    }
}