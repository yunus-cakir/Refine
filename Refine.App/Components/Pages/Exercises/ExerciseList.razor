@page "/exercises"
@using Refine.App.Models
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold m-0">Egzersizler</h3>
    <a href="/exercises/edit/0" class="btn btn-primary rounded-pill px-3 fw-bold">
        <i class="bi bi-plus-lg me-1"></i> Yeni
    </a>
</div>

@if (_exercises == null)
{
    <div class="text-center"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-3 pb-5">
        @foreach (var item in _exercises)
        {
            <div class="col-12">
                <div class="refine-card p-3 d-flex align-items-center justify-content-between">

                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 50px; height: 50px;">
                            <i class="bi bi-activity text-primary fs-4"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-0">@item.Name</h6>
                            <small class="text-muted">@item.PrimaryMuscleCategory • @item.Difficulty</small>
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-center">
                        <a href="@($"/exercises/edit/{item.Id}")" class="btn btn-warning btn-sm fw-bold text-dark d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; border-radius: 8px;">
                            <i class="bi bi-pencil-fill" style="font-size: 0.9rem;"></i>
                        </a>

                        <button class="btn btn-danger btn-sm fw-bold text-white d-flex align-items-center justify-content-center"
                                style="width: 32px; height: 32px; border-radius: 8px;"
                                @onclick="() => DeleteExercise(item)">
                            <i class="bi bi-trash-fill" style="font-size: 0.9rem;"></i>
                        </button>
                    </div>

                </div>
            </div>
        }
    </div>
}

@code {
    private List<Exercise>? _exercises;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _exercises = await DbService.GetExercisesAsync(); // Servisteki metodun adını kontrol et
    }

    private async Task DeleteExercise(Exercise ex)
    {
        bool confirm = await UiHelper.ShowConfirm("Sil",
            $"{ex.Name} silinsin mi?",
            "Evet", "Hayır");

        if (confirm)
        {
            await DbService.DeleteExerciseAsync(ex);
            await LoadData();
        }
    }
}