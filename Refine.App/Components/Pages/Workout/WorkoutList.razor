@page "/workouts"
@using Refine.App.Models.Entities
@using Refine.App.Models.UI
@using Refine.App.Models.Enums
@using Refine.App.Services
@inject LocalDbService DbService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject IPopupService PopupService
@implements IDisposable

@if (_showTopBarMenu)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
    <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
        <button class="refine-dropdown-item" @onclick="() => { ToggleTopBarMenu(); GoToPrograms(); }">
            <span class="material-symbols-outlined text-[20px]">list_alt</span>
            Show Workout Programs
        </button>
    </div>
}
@if (_activeCardMenuId.HasValue)
{
    <div class="fixed inset-0 z-40" @onclick="CloseCardMenu"></div>
}


@if (_isLoading)
{
    <RfSpinner IsLoading="true"/>
}
else
{
    <div class="workout-detail-container animate-fade-in">
        @if (_selectedProgram == null)
        {
            <div class="rf-flex-col rf-items-center" style="gap: 16px; margin-top: 48px; text-align: center;">
                <span class="material-symbols-outlined" style="font-size: 48px; color: var(--color-on-surface-variant); opacity: 0.5;">library_add_check</span>
                <p class="font-body" style="color: var(--color-on-surface-variant);">You don't have a selected Workout Program.</p>
                <button class="rf-button-inverse" style="margin-top: 8px;" @onclick="GoToPrograms">View Programs</button>
            </div>
        }
        else if (_selectedProgram.Workouts == null || !_selectedProgram.Workouts.Any())
        {
            <div class="rf-flex-col rf-items-center" style="gap: 16px; margin-top: 48px; text-align: center; opacity: 0.5;">
                <span class="material-symbols-outlined" style="font-size: 48px; color: var(--color-on-surface-variant);">event_busy</span>
                <p class="font-body" style="color: var(--color-on-surface-variant);">
                    There are no workouts in the selected program yet.
                </p>
            </div>
        }
        else
        {
            <div class="week-selector-container">
                <div class="week-selector">
                    <button class="week-btn @(_selectedTab == 0 ? "active" : "")" @onclick="() => SetTab(0)">PREVIOUS</button>
                    <button class="week-btn @(_selectedTab == 1 ? "active" : "")" @onclick="() => SetTab(1)">CURRENT</button>
                    @if (_showNextButton)
                    {
                        <button class="week-btn @(_selectedTab == 2 ? "active" : "")" @onclick="() => SetTab(2)">NEXT</button>
                    }
                </div>
            </div>
            <div class="rf-flex-row rf-items-center rf-justify-between" style="margin-bottom: 16px;">
                <span class="font-label" style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-on-surface-variant);">ACTIVE PROGRAM</span>
                <span class="refine-badge">@_selectedProgram.Name</span>
            </div>


            <div class="rf-flex-col" style="gap: 16px; padding-bottom: 80px;">
                @{ int targetWeek = _selectedTab == 0 ? (_selectedProgram.Week - 1) : (_selectedTab == 2 ? (_selectedProgram.Week + 1) : _selectedProgram.Week); }

                @if (targetWeek < 1)
                {
                    <div class="rf-flex-col rf-items-center" style="gap: 16px; margin-top: 24px; text-align: center;">
                        <span class="material-symbols-outlined" style="font-size: 48px; color: var(--color-on-surface-variant); opacity: 0.5;">directions_run</span>
                        <p class="font-body" style="color: var(--color-on-surface-variant);">You just started, keep going!</p>
                    </div>
                }
                else
                {
                    @foreach (var workout in _selectedProgram.Workouts.OrderBy(w => w.Order))
                    {
                        bool isCompleted = _completedWorkouts.ContainsKey(workout.Id) && _completedWorkouts[workout.Id];
                        bool isSkipped = !isCompleted && (_selectedTab == 0 || (_selectedTab == 1 && _highestCompletedOrder.HasValue && workout.Order < _highestCompletedOrder.Value));

                        <article class="rf-card rf-card-bordered" style="z-index: @(_activeCardMenuId == workout.Id ? "45" : "1"); @(isSkipped ? "opacity: 0.75;" : "")">
                            <!-- The left thick border -->
                            <div class="@(isCompleted ? "rf-card-border-completed" : (workout.Id == _upNextWorkoutId ? "rf-card-border-up-next" : "rf-card-border-upcoming"))" style="@(isSkipped ? "opacity: 0.5;" : "")"></div>

                            @if (_workoutHasLog.TryGetValue(workout.Id, out bool hl) && hl)
                            {
                                <RfCardMenu Id="workout.Id" @bind-ActiveMenuId="_activeCardMenuId">
                                    <button class="card-dropdown-item"
                                            @onclick="() => GoToHistoryDetail(workout.Id, targetWeek, _selectedProgram.Cycle)">
                                        <span class="material-symbols-outlined">view_day</span>
                                        View Workout Log
                                    </button>
                                    <button class="card-dropdown-item delete-btn"
                                            @onclick="() => ConfirmDeleteLog(workout.Id, targetWeek, _selectedProgram.Cycle)">
                                        <span class="material-symbols-outlined">close</span>
                                        Delete Workout Log
                                    </button>
                                </RfCardMenu>
                            }

                            <a href="@($"/workouts/detail/{workout.Id}?week={targetWeek}")" class="rf-card-bordered-content">
                                <h3 class="font-headline" style="color: @(isCompleted ? "var(--color-primary-fixed)" : (workout.Id == _upNextWorkoutId ? "#ffffff" : "var(--color-on-surface-variant)")); font-size: 20px; font-weight: bold; margin-top: 0; margin-bottom: 8px; padding-right: 24px; @(isSkipped ? "text-decoration: line-through; opacity: 0.85;" : "")">
                                    @workout.Name
                                </h3>

                                <!-- Tags -->
                                <div class="rf-flex-row rf-flex-wrap" style="gap: 8px; margin-bottom: 12px;">
                                    @foreach (var tag in GetTags(workout))
                                    {
                                        <span class="@(isCompleted || workout.Id == _upNextWorkoutId ? "rf-badge" : "rf-badge-faded")" style="font-size: 10px; padding: 3px 10px; @(workout.Id == _upNextWorkoutId ? "color: #ffffff; border-color: rgba(255, 255, 255, 0.4); background-color: rgba(255, 255, 255, 0.1);" : "") @(isSkipped ? "text-decoration: line-through; opacity: 0.8;" : "")">
                                            @tag
                                        </span>
                                    }
                                </div>

                                <!-- Divider -->
                                <div style="height: 1px; background-color: rgba(255, 255, 255, 0.05); margin-bottom: 12px; margin-left: -24px; margin-right: -20px;"></div>

                                <!-- Bottom row -->
                                <div class="rf-flex-row rf-justify-between rf-items-center">
                                    <!-- Duration -->
                                    <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-on-surface-variant); font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">schedule</span>
                                        @((workout.Items?.Sum(i => i.Sets) ?? 0) * ((_user?.WorkoutSettings?.PreferredRestTime ?? 90) + (_user?.WorkoutSettings?.AverageSetDuration ?? 45)) / 60) MIN
                                    </div>

                                    <!-- Status -->
                                    @if (isCompleted)
                                    {
                                        <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-primary-fixed); font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                                            COMPLETED
                                            <span class="material-symbols-outlined" style="font-size: 20px; font-variation-settings: 'FILL' 1;">check_circle</span>
                                        </div>
                                    }
                                    else if (workout.Id == _upNextWorkoutId)
                                    {
                                        <div @onclick="() => StartWorkoutSession(workout.Id, targetWeek, _selectedProgram.Cycle)" @onclick:stopPropagation="true" class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: #ffffff; font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer;">
                                            @(_isUpNextSaved ? "CONTINUE" : "UP NEXT")
                                            <span class="material-symbols-outlined" style="font-size: 20px; font-variation-settings: 'FILL' 1;">play_circle</span>
                                        </div>
                                    }
                                    else if (isSkipped)
                                    {
                                        <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-on-surface-variant); opacity: 0.8; font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                                            SKIPPED
                                            <span class="material-symbols-outlined" style="font-size: 20px;">cancel</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rf-flex-row rf-items-center font-label" style="gap: 6px; color: var(--color-on-surface-variant); font-size: 12px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase;">
                                            UPCOMING
                                            <span class="material-symbols-outlined" style="font-size: 20px;">radio_button_unchecked</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </article>
                    }
                }
            </div>
        }
    </div>
}

@code {
    private WorkoutProgram? _selectedProgram;
    private bool _isLoading = true;
    private bool _showTopBarMenu = false;
    private int _selectedTab = 1; // 0 = PREVIOUS, 1 = CURRENT, 2 = NEXT
    private bool _showNextButton = false;
    private int? _upNextWorkoutId;
    private int? _highestCompletedOrder;
    private Dictionary<int, bool> _completedWorkouts = new();
    private bool _isUpNextSaved = false;
    private int? _activeCardMenuId;
    private Dictionary<int, bool> _workoutHasLog = new();
    private User? _user;

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        TopBar.SetDetailMode("My Workouts");
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _user = await DbService.GetUserAsync();
        _selectedProgram = await DbService.GetSelectedWorkoutProgramAsync();

        _completedWorkouts.Clear();
        _workoutHasLog.Clear();
        if (_selectedProgram?.Workouts != null)
        {
            var orderedWorkouts = _selectedProgram.Workouts.OrderBy(w => w.Order).ToList();
            var lastWorkout = orderedWorkouts.LastOrDefault();
            _showNextButton = false;
            if (lastWorkout != null)
            {
                _showNextButton = await DbService.HasLogForWeekAsync(lastWorkout.Id, _selectedProgram.Week, _selectedProgram.Cycle);
            }

            if (!_showNextButton && _selectedTab == 2)
            {
                _selectedTab = 1;
            }

            int targetWeek = _selectedTab == 0 ? (_selectedProgram.Week - 1) : (_selectedTab == 2 ? (_selectedProgram.Week + 1) : _selectedProgram.Week);

            _workoutHasLog.Clear();
            foreach (var w in _selectedProgram.Workouts)
            {
                _completedWorkouts[w.Id] = await DbService.HasLogForWeekAsync(w.Id, targetWeek, _selectedProgram.Cycle);
                bool hasSaved = await DbService.HasSavedLogForWeekAsync(w.Id, targetWeek, _selectedProgram.Cycle);
                _workoutHasLog[w.Id] = _completedWorkouts[w.Id] || hasSaved;
            }

            // Calculate Up Next
            var completedList = orderedWorkouts.Where(w => _completedWorkouts.TryGetValue(w.Id, out bool comp) && comp).ToList();
            if (_selectedTab == 0)
            {
                _upNextWorkoutId = null;
                _highestCompletedOrder = null;
                _isUpNextSaved = false;
            }
            else
            {
                if (!completedList.Any())
                {
                    _upNextWorkoutId = orderedWorkouts.FirstOrDefault()?.Id;
                    _highestCompletedOrder = null;
                }
                else
                {
                    _highestCompletedOrder = completedList.Max(w => w.Order);
                    _upNextWorkoutId = orderedWorkouts.FirstOrDefault(w => w.Order > _highestCompletedOrder)?.Id;
                }

                if (_upNextWorkoutId.HasValue)
                {
                    _isUpNextSaved = await DbService.HasSavedLogForWeekAsync(_upNextWorkoutId.Value, targetWeek, _selectedProgram.Cycle);
                }
                else
                {
                    _isUpNextSaved = false;
                }
            }
        }
        else
        {
            _upNextWorkoutId = null;
            _highestCompletedOrder = null;
            _isUpNextSaved = false;
        }

        _isLoading = false;
    }


    private void CloseCardMenu()
    {
        _activeCardMenuId = null;
    }

    private async Task GoToHistoryDetail(int workoutId, int week, int cycle)
    {
        CloseCardMenu();
        var date = await DbService.GetWorkoutLogDateAsync(workoutId, week, cycle);
        if (date.HasValue)
        {
            NavManager.NavigateTo($"/history/detail/{workoutId}/{date.Value.Ticks}");
        }
        else
        {
            NavManager.NavigateTo("/history");
        }
    }

    private async Task ConfirmDeleteLog(int workoutId, int week, int cycle)
    {
        CloseCardMenu();
        var result = await PopupService.ShowAsync(new PopupOptions
        {
            Title = "Delete Workout Log?",
            Description = "Progress for this workout will be reset.",
            Icon = "close",
            Mode = PopupMode.Confirmation,
            CustomButtons = new List<PopupButton>
            {
                new() { Text = "Delete", ActionId = PopupResult.ConfirmedAction, Type = PopupButtonType.Destructive },
                new() { Text = "Cancel", ActionId = PopupResult.RejectedAction, Type = PopupButtonType.Ghost }
            }
        });

        if (result.IsConfirmed)
        {
            await DbService.DeleteWorkoutLogAsync(workoutId, week, cycle);
            await LoadData();
        }
    }

    private async Task SetTab(int tabIndex)
    {
        if (_selectedTab == tabIndex) return;
        _selectedTab = tabIndex;
        await LoadData();
    }

    private async Task StartWorkoutSession(int workoutId, int targetWeek, int cycle)
    {
        bool exists = await DbService.HasLogForTodayAsync(workoutId, targetWeek, cycle);
        if (exists || (workoutId == _upNextWorkoutId && _isUpNextSaved))
        {
            NavManager.NavigateTo($"/session/active/{workoutId}?resuming=true&week={targetWeek}");
        }
        else
        {
            NavManager.NavigateTo($"/session/active/{workoutId}?week={targetWeek}");
        }
    }

    private List<string> GetTags(Workout workout)
    {
        if (workout?.Items != null)
        {
            var targetMuscles = workout.Items
                .Where(i => !string.IsNullOrWhiteSpace(i.Exercise?.PrimaryMuscleCategory))
                .Select(i => i.Exercise!.PrimaryMuscleCategory!.ToUpper())
                .Distinct()
                .ToList();

            if (targetMuscles.Any())
            {
                return targetMuscles;
            }
        }

        return new List<string> { "GENERAL" };
    }

    private void GoToPrograms()
    {
        NavManager.NavigateTo("/programs");
    }


    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
    }

}
