@page "/workouts/detail/{id:int}"
@using Refine.App.Models
@using Refine.App.Services
@using Refine.App.Helpers
@implements IDisposable
@inject LocalDbService ProgramService
@inject NavigationManager NavManager
@inject TopBarBridge TopBar
@inject RecoveryService RecService
@inject IJSRuntime JS

@if (_workout == null)
{
    <RfSpinner IsLoading="true"/>
}
else
{
    @if (_showTopBarMenu)
    {
        <div class="fixed inset-0 z-40" @onclick="ToggleTopBarMenu"></div>
        <div class="refine-dropdown" style="position: fixed; top: 8px; right: 16px; z-index: 1000;">
            <button class="refine-dropdown-item" @onclick="() => { ToggleTopBarMenu(); EditWorkout(); }">
                <span class="material-symbols-outlined text-[20px]">edit</span>
                Edit Workout
            </button>
        </div>
    }

    <div class="workout-detail-container animate-fade-in">

        <!-- Target Muscles -->
        <section class="section-margin target-muscles-section">
            <h2 class="font-headline" style="font-size: 32px; font-weight: bold; color: var(--color-primary); margin: 0 0 16px 0;">@_workout.Name</h2>
            <h2 class="font-body target-muscles-title">Target Muscles</h2>
            <div class="muscle-badges-container">
                @if (_workout.Items != null)
                {
                    var targetMuscles = _workout.Items
                        .Where(i => !string.IsNullOrWhiteSpace(i.Exercise?.PrimaryMuscleCategory))
                        .Select(i => i.Exercise!.PrimaryMuscleCategory!.ToUpper())
                        .Distinct()
                        .ToList();

                    if (targetMuscles.Any())
                    {
                        foreach (var muscle in targetMuscles)
                        {
                            <span class="refine-badge">@muscle</span>
                        }
                    }
                    else
                    {
                        <span class="refine-badge">GENERAL</span>
                    }
                }
            </div>
        </section>

        <!-- Start Button -->
        <div class="button-container section-margin">
            <button class="rf-button-secondary" @onclick="StartWorkout">
                START WORKOUT
                <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
            </button>
        </div>

        <!-- CNS YÜKÜ PROGRESS BAR -->
        <div class="cns-container section-margin">
            <CnsLoadCard Title="Estimated CNS Load" CurrentLoad="TotalCnsLoad" CnsThreshold="CnsThreshold" DisplayMode="@(_currentUser?.WorkoutSettings?.CnsLoadDisplayMode ?? CnsLoadDisplayMode.Percentage)" WarningMessage="Severe CNS Fatigue! This program may overtax your nervous system." CssClass="m-0"/>
        </div>

        <!-- ESTIMATED MUSCLE IMPACT -->
        <div style="margin-bottom: 16px;">
            <MuscleFatigueList Fatigues="_estimatedMuscleFatigues" Title="Estimated Muscle Impact" EmptyMessage="No muscle impact configured." Preset="GradientPreset.MuscleImpact"/>
        </div>


        <!-- Exercises List -->
        <div class="rf-section-label">Exercises</div>
        <section class="exercises-section">
            @if (_workout.Items != null)
            {
                @foreach (var item in _workout.Items.OrderBy(i => i.Order))
                {
                    if (item.Exercise != null)
                    {
                        <ExerciseListItem Exercise="item.Exercise" OnTapped="NavigateToExerciseDetail">
                            <ChildContent>
                                @if (!string.IsNullOrWhiteSpace(item.RepsRange) && !item.RepsRange.Equals("Failure", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="exercise-stats font-body mt-1">
                                        <span class="stat-item"><span class="material-symbols-outlined stat-icon" style="font-size: 16px; margin-right: 4px;">fitness_center</span>@item.RepsRange Reps</span>
                                    </div>
                                }
                            </ChildContent>
                            <RightContent>
                                <div class="d-flex align-items-center gap-1 font-body text-white fw-bold bg-surface-variant rounded px-2 py-1" style="font-size: 14px;">
                                    <span class="material-symbols-outlined" style="font-size: 16px; color: var(--color-primary);">repeat</span>
                                    @item.Sets Sets
                                </div>
                            </RightContent>
                        </ExerciseListItem>
                    }
                }
            }
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public int? Week { get; set; }
    private Workout? _workout;
    private List<MuscleFatigueInfo>? _estimatedMuscleFatigues;

    private decimal TotalCnsLoad => _workout?.Items?.Sum(i => CalculateItemCnsLoad(i)) ?? 0;
    private decimal CnsThreshold = 150m;
    private decimal PreferredRIR = 2.0m;
    private User? _currentUser;

    private decimal CalculateItemCnsLoad(WorkoutItem item)
    {
        decimal baseScore = item.Exercise?.CnsFatigueScore ?? 0m;

        int reps = 10;
        if (!string.IsNullOrWhiteSpace(item.RepsRange))
        {
            var parts = item.RepsRange.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 0 && int.TryParse(parts.Last().Trim(), out int parsedRep))
            {
                reps = parsedRep;
            }
        }

        decimal repMultiplier = reps > 0 ? (reps / 10m) : 1.0m;
        decimal rirMultiplier = 1.0m + ((3.0m - PreferredRIR) * 0.1m);

        return baseScore * item.Sets * repMultiplier * rirMultiplier;
    }

    protected override void OnInitialized()
    {
        TopBar.OnRightActionTapped += HandleRightAction;
    }

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await ProgramService.GetUserAsync();
        if (_currentUser != null)
        {
            CnsThreshold = _currentUser.WorkoutSettings.CnsThreshold;
            PreferredRIR = _currentUser.WorkoutSettings.PreferredRIR;
        }

        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode("Workout");
            CalculateEstimatedMuscleImpact();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _workout = await ProgramService.GetWorkoutByIdAsync(Id);

        if (_workout != null)
        {
            TopBar.SetDetailMode("Workout");
            CalculateEstimatedMuscleImpact();
        }
    }

    private void CalculateEstimatedMuscleImpact()
    {
        if (_workout?.Items == null || _currentUser == null) return;

        var allExercises = _workout.Items
            .Where(i => i.Exercise != null)
            .Select(i => i.Exercise!)
            .GroupBy(e => e.Id)
            .Select(g => g.First())
            .ToList();

        var dummyLogs = new List<WorkoutLog>();

        foreach (var item in _workout.Items)
        {
            if (item.ExerciseId <= 0) continue;

            int reps = _currentUser.WorkoutSettings.PreferredMaxReps; // Default to preferred max
            if (!string.IsNullOrWhiteSpace(item.RepsRange))
            {
                var parts = item.RepsRange.Split(new[] { '-' }, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 0 && int.TryParse(parts.Last().Trim(), out int parsedRep))
                {
                    reps = parsedRep;
                }
            }

            for (int i = 0; i < item.Sets; i++)
            {
                dummyLogs.Add(new WorkoutLog
                {
                    ExerciseId = item.ExerciseId,
                    Reps = reps,
                    RIR = (int)_currentUser.WorkoutSettings.PreferredRIR
                });
            }
        }

        _estimatedMuscleFatigues = RecService.CalculateMuscleFatigue(dummyLogs, allExercises, true);
    }


    private bool _showTopBarMenu = false;

    private void ToggleTopBarMenu()
    {
        _showTopBarMenu = !_showTopBarMenu;
    }

    private void EditWorkout()
    {
        if (_workout != null)
        {
            NavManager.NavigateTo($"/workouts/edit/{_workout.WorkoutProgramId}/{_workout.Id}");
        }
    }

    private void HandleRightAction()
    {
        ToggleTopBarMenu();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TopBar.OnRightActionTapped -= HandleRightAction;
    }

    // YENİ METOT: Başlatma Mantığı
    private async Task StartWorkout()
    {
        // Bugün için belirtilen cycle'da kayıt var mı kontrol et
        bool exists = await ProgramService.HasLogForTodayAsync(Id, Week);

        string weekQuery = Week.HasValue ? $"&week={Week.Value}" : "";
        string baseQuery = Week.HasValue ? $"?week={Week.Value}" : "";

        if (exists)
        {
            // Varsa: "resuming=true" parametresiyle git
            NavManager.NavigateTo($"/session/active/{Id}?resuming=true{weekQuery}");
        }
        else
        {
            // Yoksa: Normal git
            NavManager.NavigateTo($"/session/active/{Id}{baseQuery}");
        }
    }

    private void NavigateToExerciseDetail(Exercise ex)
    {
        NavManager.NavigateTo($"/exercises/detail/{ex.Id}");
    }
}