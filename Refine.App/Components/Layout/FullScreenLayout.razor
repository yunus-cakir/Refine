@inherits LayoutComponentBase
@using Refine.App.Services
@inject NavigationManager NavManager
@inject NavigationBridge NavBridge

<div class="h-[100dvh] w-full overflow-hidden bg-background text-on-surface">
    @Body
</div>

@code {
    protected override void OnInitialized()
    {
        NavBridge.OnNavigate += HandleNavigation;
    }

    private void HandleNavigation(string uri)
    {
        NavManager.NavigateTo(uri);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavBridge.OnNavigate -= HandleNavigation;
    }
}
