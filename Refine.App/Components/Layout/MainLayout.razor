@inherits LayoutComponentBase
@using Refine.App.Services
@inject NavigationManager NavManager
@inject NavigationBridge NavBridge
@inject TopBarBridge TopBar
@inject IJSRuntime JS
@implements IDisposable

<div class="page bg-background text-on-surface">
    <main class="content">
        @Body
    </main>
</div>

<style>
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        /* Background is now handled by Tailwind's bg-background class */
    }

    /* İçerik kapsayıcısı için maksimum genişlik (Tablet/Desktop için iyi olur) */
    .content {
        width: 100%;
        max-width: 600px; /* Çok geniş ekranlarda yayılmasın */
        margin: 0 auto; /* Ortala */
        padding: 16px;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        NavBridge.OnNavigate += HandleNavigation;
        NavBridge.OnHardwareBackRequested += HandleHardwareBack;
        NavManager.LocationChanged += OnLocationChanged;

        NotifyLocation(NavManager.Uri);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        NotifyLocation(e.Location);
    }

    private void NotifyLocation(string absoluteUri)
    {
        var relativeUri = NavManager.ToBaseRelativePath(absoluteUri);
        var tabKey = "";
        if (relativeUri.StartsWith("workouts") || relativeUri.StartsWith("session") || relativeUri.StartsWith("history") || relativeUri.StartsWith("programs")) tabKey = "workouts";
        else if (relativeUri.StartsWith("analytics")) tabKey = "analytics";
        else if (relativeUri.StartsWith("profile") || relativeUri.StartsWith("preferences")) tabKey = "profile";

        NavBridge.LocationChanged(tabKey);
    }

    private void HandleNavigation(string uri)
    {
        NavManager.NavigateTo(uri);
        StateHasChanged();
    }

    private async Task<bool> HandleHardwareBack()
    {
        var currentUri = NavManager.Uri;
        var baseUri = NavManager.BaseUri;

        // If we are at the home page or a root tab, let MAUI handle it (which closes the app)
        if (currentUri == baseUri || currentUri == baseUri + "workouts" || currentUri == baseUri + "analytics" || currentUri == baseUri + "preferences")
        {
            return false;
        }

        // Otherwise, go back using JS history
        await JS.InvokeVoidAsync("history.back");
        return true;
    }

    public void Dispose()
    {
        NavBridge.OnNavigate -= HandleNavigation;
        NavBridge.OnHardwareBackRequested -= HandleHardwareBack;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}