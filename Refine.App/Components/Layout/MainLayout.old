@inherits LayoutComponentBase

<div class="page">
    <main class="content">
        @Body
    </main>

    <NavMenu />
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<style>
    /* Sayfa yapısı */
    .page {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        background-color: var(--refine-bg); /* app.css'den gelir */
    }

    .content {
        flex: 1;
        padding: 1rem;
        /* Navigasyon barın yüksekliği kadar alttan boşluk bırak */
        padding-bottom: calc(var(--navbar-height) + 20px);
        overflow-y: auto; /* İçerik kaydırılabilir olsun */
    }
</style>