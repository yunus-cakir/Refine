@using Refine.App.Models.Entities
@using Refine.App.Models.UI
@using Refine.App.Models.Enums

@if (IsLoading)
{
    <div class="rf-dashboard-card skeleton-box" style="height: 140px; --card-weight: @WidthWeight;" @attributes="AdditionalAttributes"></div>
}
else
{
    <div class="@CombinedClass" @onclick="OnClick" style="@CombinedStyle" @attributes="FilteredAttributes">
        @{
            var gradientColor = !string.IsNullOrEmpty(BackgroundGradientColor) ? BackgroundGradientColor : (ProgressColor?.CurrentPrimaryColor ?? "var(--color-primary)");
        }
        @if (!string.IsNullOrEmpty(gradientColor))
        {
            <div style="position: absolute; inset: 0; opacity: 0.1; background: radial-gradient(circle at top left, @gradientColor, transparent 70%); pointer-events: none;"></div>
        }

        @if (!string.IsNullOrEmpty(Icon) || !string.IsNullOrEmpty(Title) || HeaderRightContent != null)
        {
            <div class="rf-flex-row rf-items-start" style="justify-content: space-between; z-index: 10; position: relative;">
                <div class="rf-flex-row rf-items-center" style="gap: 8px; color: @TitleColor; min-height: 24px;">
                    @if (!string.IsNullOrEmpty(Icon))
                    {
                        <span class="material-symbols-outlined" style="font-size: 18px; font-variation-settings: 'FILL' @(IconFill ? 1 : 0);">@Icon</span>
                    }
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        <span class="font-label" style="font-size: 11px; text-transform: uppercase; font-weight: bold; letter-spacing: 0.1em;">@Title</span>
                    }
                </div>
                
                @if (HeaderRightContent != null)
                {
                    <div class="rf-flex-row rf-items-start">
                        @HeaderRightContent
                    </div>
                }
            </div>
        }

        @if (Content != null)
        {
            <div style="z-index: 10; position: relative; flex: 1; display: flex; flex-direction: column; margin-top: 8px;">
                @Content
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(PrimaryText) || !string.IsNullOrEmpty(SecondaryText))
            {
                <div class="rf-flex-row" style="align-items: baseline; gap: 8px; z-index: 10; position: relative;">
                    @if (!string.IsNullOrEmpty(PrimaryText))
                    {
                        <span class="font-headline" style="font-size: 36px; font-weight: bold; color: @PrimaryTextColor;">@PrimaryText</span>
                    }
                    @if (!string.IsNullOrEmpty(SecondaryText))
                    {
                        <span class="font-body" style="font-size: 14px; color: var(--color-on-surface-variant);">@SecondaryText</span>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="font-label" style="font-size: 10px; color: @SubtitleColor; margin-top: auto; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; z-index: 10; position: relative; @(SubtitleColor == "transparent" ? "user-select: none;" : "")">
                    @Subtitle
                </p>
            }

            @if (ShowProgressBar)
            {
                <div style="width: 100%; background-color: @ProgressBackgroundColor; height: 6px; border-radius: 9999px; overflow: hidden; margin-top: @(string.IsNullOrEmpty(Subtitle) ? "auto" : "4px"); z-index: 10; position: relative;">
                    <div style="background: linear-gradient(90deg, @(ProgressColor?.CurrentPrimaryColor ?? "var(--color-primary)"), @(ProgressColor?.CurrentSecondaryColor ?? "var(--color-primary)")); width: @(Math.Min(ProgressValue, 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%; height: 100%; border-radius: 9999px;"></div>
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int WidthWeight { get; set; } = 1;
    [Parameter] public string Icon { get; set; }
    [Parameter] public bool IconFill { get; set; }
    [Parameter] public string Title { get; set; }
    [Parameter] public string TitleColor { get; set; } = "var(--color-on-surface-variant)";
    [Parameter] public string PrimaryText { get; set; }
    [Parameter] public string PrimaryTextColor { get; set; } = "var(--color-on-surface)";
    [Parameter] public string SecondaryText { get; set; }
    [Parameter] public string Subtitle { get; set; }
    [Parameter] public string SubtitleColor { get; set; } = "var(--color-on-surface-variant)";
    [Parameter] public bool ShowProgressBar { get; set; }
    [Parameter] public double ProgressValue { get; set; }
    [Parameter] public GradientColor ProgressColor { get; set; } = new GradientColor { CurrentPrimaryColor = "var(--color-primary)", CurrentSecondaryColor = "var(--color-primary)" };
    [Parameter] public string ProgressBackgroundColor { get; set; } = "var(--color-surface-container-highest)";
    [Parameter] public string BackgroundGradientColor { get; set; }
    [Parameter] public RenderFragment? HeaderRightContent { get; set; }
    [Parameter] public RenderFragment? Content { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CombinedClass
    {
        get
        {
            var c = "rf-dashboard-card";
            if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("class", out var customClass))
            {
                c += $" {customClass}";
            }
            return c;
        }
    }

    private string CombinedStyle
    {
        get
        {
            var s = $"position: relative; overflow: hidden; --card-weight: {WidthWeight}; display: flex; flex-direction: column;";
            if (OnClick.HasDelegate) s += " cursor: pointer;";
            if (AdditionalAttributes != null && AdditionalAttributes.TryGetValue("style", out var customStyle))
            {
                s += $" {customStyle}";
            }
            return s;
        }
    }

    private Dictionary<string, object>? FilteredAttributes
    {
        get
        {
            if (AdditionalAttributes == null) return null;
            var dict = new Dictionary<string, object>(AdditionalAttributes);
            dict.Remove("class");
            dict.Remove("style");
            return dict;
        }
    }
}

