@using Refine.App.Models.Entities
@using Refine.App.Models.UI
@using Refine.App.Models.Enums

@{
    var progressPercentage = (decimal)(Ratio * 100);
    var dynamicColor = GradientPreset.Tier.GetColor(progressPercentage);
    var activeColor = Ratio >= 0.8 ? dynamicColor.CurrentPrimaryColor : "var(--color-on-surface-variant)";
    var subtitleColor = Ratio >= 0.8 ? dynamicColor.CurrentPrimaryColor : "transparent";
}

<HomeCard
    WidthWeight="WidthWeight"
    IsLoading="IsLoading"
    Icon="local_fire_department"
    IconFill="Ratio >= 0.8"
    Title="Streak"
    TitleColor="@activeColor"
    PrimaryText="@CompletedDays.ToString()"
    SecondaryText="@($"/ {TotalDays} days")"
    Subtitle='@(Ratio >= 0.8 ? "CRUSHING IT!" : "KEEP GOING")'
    SubtitleColor="@subtitleColor"
    ShowProgressBar="true"
    ProgressValue="@(Ratio * 100)"
    ProgressColor="@dynamicColor"
    ProgressBackgroundColor="rgba(255,255,255,0.05)"
/>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public int WidthWeight { get; set; } = 1;
    [Parameter] public int CompletedDays { get; set; }
    [Parameter] public int TotalDays { get; set; }
    [Parameter] public double Ratio { get; set; }
}

