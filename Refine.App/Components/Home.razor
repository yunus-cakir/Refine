@page "/"
@using Refine.App.Models
@using Refine.App.Services
@using Refine.App.Components.Pages.Analytics
@inject TopBarBridge TopBar
@inject NavigationManager NavManager
@inject HomeStateService StateService
@implements IDisposable

<div class="font-body min-h-screen" style="background-color: var(--color-background); color: var(--color-on-surface); min-height: 100vh;">

    <main class="rf-flex-col" style="gap: 16px; max-width: 768px; margin: 0 auto;">
        <!-- Welcome Section -->
        <section class="rf-flex-col" style="gap: 8px;">
            @if (!StateService.IsUserLoaded)
            {
                <div class="skeleton-box" style="width: 120px; height: 16px; border-radius: 4px;"></div>
                <div class="skeleton-box" style="width: 240px; height: 32px; border-radius: 4px;"></div>
            }
            else
            {
                <p class="font-label" style="color: var(--color-on-surface-variant); font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;">@DateTime.Now.ToString("dddd, MMM dd").ToUpper()</p>
                <h1 class="font-headline" style="color: var(--color-tertiary); font-size: 28px; font-weight: bold;">Welcome, @(StateService.User?.FirstName ?? "Sporcu")!</h1>
            }
        </section>

        <!-- Main CTA Card: Next Workout -->
        <section>
            @if (!StateService.IsUpNextLoaded || StateService.UpNextWorkout != null)
            {
                <UpNextCard 
                    IsLoading="!StateService.IsUpNextLoaded"
                    Workout="StateService.UpNextWorkout"
                    MuscleGroups="@StateService.UpNextMuscleGroups"
                    Duration="StateService.UpNextDuration"
                    IsSaved="StateService.UpNextIsSaved"
                    OnCardClick="NavigateToWorkoutDetail"
                    OnStartClick="StartUpNextWorkout" />
            }
        </section>

        <!-- Bento Grid: Stats & Analytics -->
        <section class="rf-flex-col" style="gap: 16px;">
            <div class="rf-dashboard-row">
                <!-- Recovery Metric -->
                <RecoveryCard WidthWeight="1" IsLoading="!StateService.IsRecoveryLoaded" Value="StateService.RecoveryState.OverallRecoveryScore" OnClick="NavigateToRecovery" />

                <!-- Streak Metric -->
                <StreakCard WidthWeight="1"
                    IsLoading="!StateService.IsStreakLoaded"
                    CompletedDays="StateService.StreakCompletedDays"
                    TotalDays="StateService.StreakTotalDays"
                    Ratio="StateService.StreakRatio" />
            </div>

            @if (!StateService.IsTopExerciseLoaded)
            {
                <div class="rf-card skeleton-box" style="width: 100%; height: 160px; border: none; box-shadow: none;"></div>
            }
            else if (StateService.TopExercise != null)
            {
                <ExerciseSparklineChart 
                    style="width: 100%;"
                    ExerciseId="StateService.TopExercise.Id"
                    ExerciseName="@StateService.TopExercise.Name"
                    LastTrained="StateService.TopExerciseLastTrained"
                    DataPoints="StateService.TopExerciseDataPoints"
                    RateOfChange="StateService.TopExerciseRateOfChange"
                    Subtitle="Best Progress (30D)"
                    MetricUnitLabel="pts"
                    ShowValueBadge="false"
                    ReverseLayout="true"
                    OnClick="NavigateToDetail" />
            }
        </section>
    </main>
</div>

@code {
    private Action _stateHasChangedAction;

    protected override void OnInitialized()
    {
        TopBar.SetHomeMode();
        
        _stateHasChangedAction = () => InvokeAsync(StateHasChanged);
        StateService.OnStateChanged += _stateHasChangedAction;
        
        // Start background load without awaiting
        _ = StateService.LoadDataAsync();
    }

    public void Dispose()
    {
        if (_stateHasChangedAction != null)
        {
            StateService.OnStateChanged -= _stateHasChangedAction;
        }
    }

    private void NavigateToDetail(int exerciseId)
    {
        NavManager.NavigateTo($"/analytics/detail/{exerciseId}");
    }

    private void NavigateToWorkoutDetail()
    {
        if (StateService.UpNextWorkout != null)
        {
            NavManager.NavigateTo($"/workouts/detail/{StateService.UpNextWorkout.Id}?week={StateService.UpNextWeek}");
        }
    }

    private void StartUpNextWorkout()
    {
        if (StateService.UpNextWorkout != null)
        {
            NavManager.NavigateTo($"/session/active/{StateService.UpNextWorkout.Id}?week={StateService.UpNextWeek}");
        }
    }

    private void NavigateToRecovery()
    {
        NavManager.NavigateTo("/analytics/recovery");
    }
}