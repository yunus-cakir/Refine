@if (IsLoading)
{
    <div class="loader-container">
        <span class="material-symbols-outlined animate-spin" style="color: @Color; font-size: @(Size)px;">@Icon</span>
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; } = true;
    [Parameter] public string Color { get; set; } = "var(--color-primary-fixed)";
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public string Icon { get; set; } = "progress_activity";
}
