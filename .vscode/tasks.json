{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Blazor Watch Android",
            "type": "shell",
            "command": "dotnet watch --project Refine.App/Refine.App.csproj build -t:Run -f net9.0-android --no-launch-profile /p:AndroidSdkDirectory='/Users/anonymus/Library/Android/sdk'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        }
    ]
}
